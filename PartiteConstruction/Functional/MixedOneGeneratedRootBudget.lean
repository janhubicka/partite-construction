import PartiteConstruction.Functional.MixedSmallRootGeneratorBudget
import PartiteConstruction.Functional.OneGeneratorFreeAmalgam

/-!
# Mixed full-functional free amalgams with a ONE-GENERATED common root

The previous generator-budget theorem counted the number of vertices of
the common root. This stronger version counts only the size of an EXACT
generating set of the common full functional structure.

For a genuinely mixed n-generated source, each closed side loses at
least one generator of the whole source. If the common root is itself
generated by at most one element, its ENTIRE image in either side is
generated by that one vertex; the previous cardinal budget is therefore
preserved, even when the root has many function-generated vertices.

This reduction works in arbitrary finite set-valued-function languages
and does not use U-closures, relational replay or the recursive Ramsey
construction. It is independent of the special native EHN projection.
-/

namespace StructuralRamsey.Structure.IsFreeAmalgam

universe u v
variable {L : Language.{u}}
variable {H E F C : Type v}
variable {Root : Structure L H}
variable {Left : Structure L E}
variable {Right : Structure L F}
variable {Whole : Structure L C}
variable {sL : Embedding Root Left}
variable {sR : Embedding Root Right}
variable {iL : Embedding Left Whole}
variable {iR : Embedding Right Whole}

/-- One outside-left generator pays for a ONE-GENERATED common root.
The root may contain arbitrarily many additional closure vertices.
The source and left side may be much larger than n as sets. -/
theorem left_generatedByAtMost_of_mixed_one_generated_root
    [Finite H] [Finite E]
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hNotLeft : ¬ ∀ x : C, ∃ a : E, x = iL a)
    (hRootGen : Root.GeneratedByAtMost 1)
    {n : ℕ}
    (hgen : Whole.GeneratedByAtMost n) :
    Left.GeneratedByAtMost n := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype E := Fintype.ofFinite E
  rcases hgen with ⟨G, hGcard, hGgen⟩
  obtain ⟨RootSeeds, hSeedCard, hSeedGen⟩ := hRootGen

  have hOutsideGen : ∃ g : C, g ∈ G ∧ g ∉ Set.range iL := by
    by_contra hn
    apply hNotLeft
    intro z
    have hSeed : (↑G : Set C) ⊆ Set.range iL := by
      intro y hy
      by_contra hyOut
      exact hn ⟨y, hy, hyOut⟩
    have hz : z ∈ Whole.functionClosure (↑G : Set C) := by
      rw [hGgen]
      exact Set.mem_univ z
    obtain ⟨a, ha⟩ := hz (Set.range iL) iL.range_isClosed hSeed
    exact ⟨a, ha.symm⟩
  obtain ⟨g, hgG, hgOut⟩ := hOutsideGen

  let leftGen : Finset E :=
    (Finset.univ : Finset E).filter (fun x => iL x ∈ G)
  let rootGen : Finset E :=
    RootSeeds.image sL
  let generators : Finset E := leftGen ∪ rootGen

  have hLeftGenCard : leftGen.card + 1 ≤ G.card := by
    let phi : ↥(↑leftGen : Set E) → ↥(↑(G.erase g) : Set C) :=
      fun x => ⟨iL x.1, by
        apply Finset.mem_erase.mpr
        constructor
        · intro hx
          exact hgOut ⟨x.1, hx⟩
        · exact (Finset.mem_filter.mp x.2).2⟩
    have hphi : Function.Injective phi := by
      intro x y hxy
      apply Subtype.ext
      apply iL.injective
      exact congrArg Subtype.val hxy
    have hle : leftGen.card ≤ (G.erase g).card := by
      calc
        leftGen.card = Fintype.card ↥(↑leftGen : Set E) := by simp
        _ ≤ Fintype.card ↥(↑(G.erase g) : Set C) :=
          Fintype.card_le_of_injective phi hphi
        _ = (G.erase g).card :=
          Fintype.card_coe (G.erase g)
    have hErase : (G.erase g).card = G.card - 1 :=
      Finset.card_erase_of_mem hgG
    have hPos : 0 < G.card := Finset.card_pos.mpr ⟨g, hgG⟩
    omega

  have hRootGenCard : rootGen.card ≤ 1 := by
    exact (Finset.card_image_le (s := RootSeeds) (f := sL)).trans hSeedCard

  refine ⟨generators, ?_, ?_⟩
  · calc
      generators.card ≤ leftGen.card + rootGen.card :=
        Finset.card_union_le _ _
      _ ≤ G.card := by omega
      _ ≤ n := hGcard
  · ext x
    constructor
    · intro _
      simp
    · intro _
      intro T hT hGeneratorsT

      let TWhole : Set C :=
        Set.range iR ∪ iL '' T

      have hCommonT : ∀ d : H, sL d ∈ T := by
        have hPre : Root.IsClosed {d : H | sL d ∈ T} :=
          sL.preimage_isClosed T hT
        have hSeeds : (↑RootSeeds : Set H) ⊆ {d : H | sL d ∈ T} := by
          intro d hd
          apply hGeneratorsT
          apply Finset.mem_union_right
          exact Finset.mem_image.mpr ⟨d, hd, rfl⟩
        intro d
        have hd : d ∈ Root.functionClosure (↑RootSeeds : Set H) := by
          rw [hSeedGen]
          exact Set.mem_univ d
        exact hd {d : H | sL d ∈ T} hPre hSeeds

      have hTWholeClosed : Whole.IsClosed TWhole := by
        intro F0 args hargs y hy
        rcases (hfree.func_iff F0 args y).mp hy with
          hleft | hright
        · rcases hleft with ⟨a, b, hb, hargsEq, hyEq⟩
          have haT : ∀ k, a k ∈ T := by
            intro k
            have hk : iL (a k) ∈ TWhole := by
              have hk0 := hargs k
              rw [hargsEq] at hk0
              exact hk0
            rcases hk with hR | hL
            · rcases hR with ⟨r, hr⟩
              obtain ⟨d, had, _⟩ :=
                (hfree.overlap (a k) r).mp hr.symm
              rw [had]
              exact hCommonT d
            · rcases hL with ⟨a', ha'T, ha'eq⟩
              have haa : a' = a k := iL.injective ha'eq
              simpa [haa] using ha'T
          have hbT : b ∈ T := hT F0 a haT hb
          exact Or.inr ⟨b, hbT, hyEq.symm⟩
        · rcases hright with ⟨a, b, hb, hargsEq, hyEq⟩
          exact Or.inl ⟨b, hyEq.symm⟩

      have hGTWhole : (↑G : Set C) ⊆ TWhole := by
        intro g hg
        rcases hfree.covers g with ⟨l, hgl⟩ | ⟨r, hgr⟩
        · have hlLeftGen : l ∈ leftGen := by
            apply Finset.mem_filter.mpr
            exact ⟨Finset.mem_univ l, by simpa [hgl] using hg⟩
          have hlT : l ∈ T := by
            apply hGeneratorsT
            exact Finset.mem_union_left rootGen hlLeftGen
          exact Or.inr ⟨l, hlT, hgl.symm⟩
        · exact Or.inl ⟨r, hgr.symm⟩

      have hxWhole : iL x ∈ TWhole := by
        have hxClosure : iL x ∈ Whole.functionClosure (↑G : Set C) := by
          rw [hGgen]
          simp
        exact hxClosure TWhole hTWholeClosed hGTWhole

      rcases hxWhole with hR | hL
      · rcases hR with ⟨r, hr⟩
        obtain ⟨d, hxd, _⟩ :=
          (hfree.overlap x r).mp hr.symm
        rw [hxd]
        exact hCommonT d
      · rcases hL with ⟨l, hlT, hleq⟩
        have hlx : l = x := iL.injective hleq
        simpa [hlx] using hlT


/-- The same n-generator bound holds on BOTH closed sides of a genuinely
mixed full functional free amalgam whenever its common root has at
most one generator, irrespective of the root's vertex count. -/
theorem sides_generatedByAtMost_of_mixed_one_generated_root
    [Finite H] [Finite E] [Finite F]
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hNotLeft : ¬ ∀ x : C, ∃ a : E, x = iL a)
    (hNotRight : ¬ ∀ x : C, ∃ b : F, x = iR b)
    (hRootGen : Root.GeneratedByAtMost 1)
    {n : ℕ} (hgen : Whole.GeneratedByAtMost n) :
    Left.GeneratedByAtMost n ∧ Right.GeneratedByAtMost n := by
  constructor
  · exact hfree.left_generatedByAtMost_of_mixed_one_generated_root
      hNotLeft hRootGen hgen
  · exact hfree.swap.left_generatedByAtMost_of_mixed_one_generated_root
      hNotRight hRootGen hgen

end StructuralRamsey.Structure.IsFreeAmalgam
