import PartiteConstruction.Functional.MixedOneGeneratedRootBudget
import PartiteConstruction.Functional.OriginalPartialIrreducibleRootRelativeWitness
import PartiteConstruction.Functional.EHNNativeOriginalPartialEmptyRoot

/-!
# One-generated roots are functionally irreducible and synchronize strict trees

A full function structure generated by <=1 element is irreducible in
the universal no-crossing sense: otherwise a proper free decomposition
would force all of it into one proper closed side. The root may have
arbitrarily many vertices generated by the one chosen element.

For an n-generated GENUINELY mixed full free-amalgam, an outside
generator pays for the one root generator, so both sides remain
n-generated (proved independently in MixedOneGeneratedRootBudget).
Their ordinary strict original-partial B-tree completions can then be
synchronized over the SAME prescribed Base copy, using the already
proved irreducible-root relative extension theorem.

This is a stronger case than the already verified empty-vertex-root
and singleton-vertex-root variants. It does not yet handle a root
that actually needs >=2 generators, even if its projected image has
small rank in the control A.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {H : Type v}

/-- Any FULL set-valued-function structure generated by at most one
vertex is irreducible for the universal free-amalgamation notion.
No bound on its function-closed cardinality is required. -/
theorem irreducible_of_one_generated
    (Root : Structure L H)
    (hGen : Root.GeneratedByAtMost 1) :
    Root.Irreducible := by
  apply (irreducible_iff_noProperFreeDecomposition Root).mpr
  rintro ⟨d⟩
  rcases d.free.one_generated_source_contained_in_side hGen with hL | hR
  · apply d.leftProper
    intro x
    obtain ⟨y, hxy⟩ := hL x
    exact ⟨y, hxy.symm⟩
  · apply d.rightProper
    intro x
    obtain ⟨y, hxy⟩ := hR x
    exact ⟨y, hxy.symm⟩

end StructuralRamsey.Structure

namespace StructuralRamsey.Structure.IsFreeAmalgam

universe u v
variable {L : Language.{u}}
variable {H E F C VB : Type v}

/-- Genuine mixed n-generated full free amalgams whose common ROOT is
ONE-GENERATED admit two synchronized relative B-tree completions.
The target Start is the same prescribed full Base copy and the maps
need only satisfy the original 2019 partial-function convention. -/
theorem compatibleOriginalPartialRelativeCompletions_one_generated_root
    {Root : Structure L H}
    {Left : Structure L E} {Right : Structure L F}
    {Whole : Structure L C}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    [Finite H] [Finite E] [Finite F]
    (hFree : IsFreeAmalgam sL sR iL iR)
    (hNotLeft : ¬ ∀ x : C, ∃ a : E, x = iL a)
    (hNotRight : ¬ ∀ x : C, ∃ b : F, x = iR b)
    (Base : Structure L VB) (hBase : Base.Irreducible)
    (q : Embedding Root Base) (n : ℕ)
    (hRootGen : Root.GeneratedByAtMost 1)
    (hWholeGen : Whole.GeneratedByAtMost n)
    (hLeftRank : LocallyGeneratedOriginalPartialTreeCompletable
      Base Left n)
    (hRightRank : LocallyGeneratedOriginalPartialTreeCompletable
      Base Right n) :
    HasOriginalPartialTreeExtensionCompletion
        (Start := Base) Base sL q ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Base) Base sR q := by
  classical
  obtain ⟨hLeftGen, hRightGen⟩ :=
    hFree.sides_generatedByAtMost_of_mixed_one_generated_root
      hNotLeft hNotRight hRootGen hWholeGen
  have hRoot : Root.Irreducible :=
    irreducible_of_one_generated Root hRootGen
  have hLeft : HasOriginalPartialTreeCompletion Base Left :=
    hLeftRank.completion_of_embedding
      Left hLeftGen (Embedding.id Left)
  have hRight : HasOriginalPartialTreeCompletion Base Right :=
    hRightRank.completion_of_embedding
      Right hRightGen (Embedding.id Right)
  exact ⟨
    HasOriginalPartialTreeExtensionCompletion.of_irreducible_root_absolute
      Base hBase hRoot sL q hLeft,
    HasOriginalPartialTreeExtensionCompletion.of_irreducible_root_absolute
      Base hBase hRoot sR q hRight⟩

end StructuralRamsey.Structure.IsFreeAmalgam
