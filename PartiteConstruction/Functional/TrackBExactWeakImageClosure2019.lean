import PartiteConstruction.Functional.TrackBOneWayClosureHull2019
import PartiteConstruction.Functional.TrackBRealEHNExactImageUSize2019
import PartiteConstruction.Functional.WholeMaskWholeWeakUSize2019
import PartiteConstruction.Functional.NativePartiteWeakUClosureRankDictionary
import PartiteConstruction.Functional.NativePartialClosure

/-!
# Track B: generated closures along exact original-2019 weak images

A source-defined genuine partial homomorphism f:A→B preserves all
complete defined source fibre images without reflecting undefined
inputs. Its EXACT whole-weak source test S maps into the whole-weak
target test on the literal image I=f''S, and the image of the
source-generated closure of EVERY seed Q⊆S is contained in the
target whole-weak closure generated by the exact image of Q.

The independently verified one-way whole→clipped comparison then
bounds that image by the target CLIPPED weak closure. This is a
genuine source-side closure-transport theorem, strictly stronger
than an inequality of generator counts.

For the ACTUAL EHN weak part projection in an arbitrary finite
native Stage, this gives a same-map/same-carrier statement and its
two canonical ambient 2019 UClosureHull presentation: the image of
the WHOLE-mask source closure is contained in the CLIPPED
output-part-split control closure on the literal image I.

No hull replaces the tested S or I. No target FULL embedding,
intrinsic-local H-relative completion, or strict functional B-tree
witness is inferred.
-/

namespace StructuralRamsey.PartialSetStructure

open StructuralRamsey.Structure

universe u v w
variable {L : Language.{u}} {V : Type v} {W : Type w}

/-- For every exact S and Q⊆S, the original source-defined
homomorphism's exact weak image of WHOLE-fibre generated closure
lies inside the CLIPPED target closure generated by the exact
image seed. Both restricted carriers and the map are unchanged. -/
theorem IsOriginalPartialHomomorphism.wholeWeakImageClosure_subset_clipped
    {A : PartialSetStructure L V} {B : PartialSetStructure L W}
    {f : V → W}
    (hf : IsOriginalPartialHomomorphism A B f)
    (S : Set V) (Q : Set S) :
    Structure.imageSet (wholeWeakImageMap f S)
      ((wholeWeakInduce A S).functionClosure Q) ⊆
    (weakInduce B (Structure.imageSet f S)).functionClosure
      (Structure.imageSet (wholeWeakImageMap f S) Q) := by
  have hWhole :=
    (hf.wholeWeakImage S).image_functionClosure_subset Q
  have hClip :=
    B.wholeWeakFunctionClosure_subset_clipped
      (Structure.imageSet f S)
      (Structure.imageSet (wholeWeakImageMap f S) Q)
  exact hWhole.trans hClip

end StructuralRamsey.PartialSetStructure

namespace StructuralRamsey.FunctionalPartite.EHN

open StructuralRamsey.Structure
open StructuralRamsey.PartialSetStructure
open StructuralRamsey.RelStructure

universe u v
variable {L : Language.{u}} {P : Type v} [Fintype P]
variable {K : Structure.StructureClass (L := L)}
variable {D : Structure L P}

/-- The ACTUAL finite EHN Stage's source-defined weak part
projection transports WHOLE-fibre source-generated closures to
CLIPPED target-generated closures on the exact image. It needs
only the stored WeaklyPartiteOver invariant, not ProjectionHom. -/
theorem Stage.exactWholeImageClosure_subset_clipped
    (T : Stage K D)
    (S : Set T.Carrier) (Q : Set S) :
    Structure.imageSet
        (wholeWeakImageMap T.system.part S)
        ((wholeWeakInduce T.system.toStructure.toNonemptyPartial S).functionClosure Q) ⊆
      (weakInduce D.toNonemptyPartial (Structure.imageSet T.system.part S)).functionClosure
        (Structure.imageSet (wholeWeakImageMap T.system.part S) Q) := by
  have hf : IsOriginalPartialHomomorphism
      T.system.toStructure.toNonemptyPartial D.toNonemptyPartial T.system.part :=
    T.system.weaklyPartite_toNonemptyPartial_originalHom D T.isPartite
  exact hf.wholeWeakImageClosure_subset_clipped S Q

/-- In the two distinct canonical 2019 ambient OLD presentations,
the ACTUAL EHN projection image of the WHOLE-mask UClosureHull
of Q on S sits inside the CLIPPED output-part-indexed UClosureHull
of the exact image seed, on I=part''S.

No equality of the tagged languages and no closure enlargement of
the tested carriers; this is the precise image-level transport
missing from a bare minimum-generator rank inequality. -/
theorem Stage.exactImageWholeMaskUClosureHull_subset_clipped
    (T : Stage K D)
    (hPos : L.PositiveFuncArity)
    (S : Set T.Carrier) (Q : Set S) :
    Structure.imageSet (wholeWeakImageMap T.system.part S)
      (UClosureHull (L.wholeMaskClosureRules P)
        ((wholeMaskTagExpansion
          (T.system.toStructure.toNonemptyPartial.wholeMaskPatternGraph
            T.system.part)).induce S) Q) ⊆
    UClosureHull (L.outputPartIndexed P).patternClosureRules
      ((patternTagExpansion
        ((transversal D).splitOutputParts).toStructure.patternGraph).induce
          (Structure.imageSet T.system.part S))
      (Structure.imageSet (wholeWeakImageMap T.system.part S) Q) := by
  let I : Set P := Structure.imageSet T.system.part S
  let g : S → I := wholeWeakImageMap T.system.part S
  let G : Set I := Structure.imageSet g Q
  have hSource :
      (wholeWeakInduce T.system.toStructure.toNonemptyPartial S).functionClosure Q =
      UClosureHull (L.wholeMaskClosureRules P)
        ((wholeMaskTagExpansion
          (T.system.toStructure.toNonemptyPartial.wholeMaskPatternGraph
            T.system.part)).induce S) Q :=
    T.system.toStructure.toNonemptyPartial.wholeWeakFunctionClosure_eq_inducedAmbientUClosureHull
      T.system.part hPos T.system.toNonemptyPartial_fibreTransversal S Q
  have hTarget :
      (weakInduce D.toNonemptyPartial I).functionClosure G =
      UClosureHull (L.outputPartIndexed P).patternClosureRules
        ((patternTagExpansion
          ((transversal D).splitOutputParts).toStructure.patternGraph).induce I) G := by
    rw [← Structure.toNonemptyPartial_weakInduce_commute]
    rw [Structure.toNonemptyPartial_functionClosure]
    exact (transversal D).weakFunctionClosure_eq_outputTaggedUClosureHull
      hPos I G
  have hMap :
      Structure.imageSet g
        ((wholeWeakInduce T.system.toStructure.toNonemptyPartial S).functionClosure Q) ⊆
      (weakInduce D.toNonemptyPartial I).functionClosure G :=
    T.exactWholeImageClosure_subset_clipped S Q
  calc
    Structure.imageSet g
      (UClosureHull (L.wholeMaskClosureRules P)
        ((wholeMaskTagExpansion
          (T.system.toStructure.toNonemptyPartial.wholeMaskPatternGraph
            T.system.part)).induce S) Q)
        = Structure.imageSet g
            ((wholeWeakInduce T.system.toStructure.toNonemptyPartial S).functionClosure Q) :=
          congrArg (Structure.imageSet g) hSource.symm
    _ ⊆ (weakInduce D.toNonemptyPartial I).functionClosure G := hMap
    _ = UClosureHull (L.outputPartIndexed P).patternClosureRules
      ((patternTagExpansion
        ((transversal D).splitOutputParts).toStructure.patternGraph).induce I) G :=
      hTarget

end StructuralRamsey.FunctionalPartite.EHN
