import PartiteConstruction.Functional.MaximalHardRootC5NativeAttachment
import PartiteConstruction.Functional.ClosedGeneratorRank

/-!
# The native mixed five-cycle test has EXACT generator rank five

The previously certified actual UnitAttachD has a five-vertex
closed mixed test with all five control part labels distinct.
In the function-free language the function-closure operator on
ANY subset is literally the identity. Consequently the exact
closed five-cycle is generated by five vertices, and by no
set of four vertices.

This proves the numerical MAXIMAL-RANK hypothesis for n=5 of
the unrestricted hard-root C5 audit, without conflating generator
rank with the size of an ambient closure hull or merely observing
that the part projection is injective.

The local rank hypotheses for all old/core tests and the Stage
class membership are separate; the real Hales-Jewett power core
does not coincide with this arbitrary C5 core.
-/

namespace StructuralRamsey.Structure.MaximalHardRootFiveCycle

open StructuralRamsey
open StructuralRamsey.Structure

noncomputable section

/-- The exact native five-cycle is fully induced on the original
five vertices and is function-closed (the language has no functions). -/
abbrev nativeClosedCycle :=
  nativeAttached.toStructure.induce nativeCycleSet nativeCycleSet_closed

/-- The five cyclic names enumerate the exact carrier bijectively.
No attached outside vertex is inserted into this test. -/
def nativeCycleEquiv : Fin 5 ≃ nativeCycleSet :=
  Equiv.ofBijective
    (fun i : Fin 5 =>
      (⟨nativeCycle i, ⟨i,rfl⟩⟩ : nativeCycleSet)) (by
      constructor
      · intro i j hij
        exact nativeCycle_injective (congrArg Subtype.val hij)
      · intro z
        obtain ⟨i,hi⟩ := z.2
        refine ⟨i, ?_⟩
        apply Subtype.ext
        exact hi)

theorem nativeCycle_card :
    Nat.card nativeCycleSet = 5 := by
  letI : Fintype nativeCycleSet := Fintype.ofFinite nativeCycleSet
  calc
    Nat.card nativeCycleSet = Fintype.card nativeCycleSet :=
      Nat.card_eq_fintype_card
    _ = Fintype.card (Fin 5) :=
      Fintype.card_congr nativeCycleEquiv.symm
    _ = 5 := by simp

/-- With NO function symbols, the closure of a vertex set inside
the exact induced five-cycle is the vertex set itself. -/
theorem nativeClosedCycle_functionClosure_eq
    (S : Set nativeCycleSet) :
    nativeClosedCycle.functionClosure S = S := by
  apply Set.Subset.antisymm
  · intro x hx
    exact hx S (by
      intro F
      exact Empty.elim F) (Set.Subset.rfl)
  · exact nativeClosedCycle.subset_functionClosure S

/-- Every vertex can be used as a generator: the closed test
is generated by at most five vertices. -/
theorem nativeClosedCycle_generatedByAtMost_five :
    nativeClosedCycle.GeneratedByAtMost 5 := by
  classical
  letI : Fintype nativeCycleSet := Fintype.ofFinite nativeCycleSet
  have h := Structure.GeneratedByAtMost.of_fintype nativeClosedCycle
  have hc : Fintype.card nativeCycleSet = 5 := by
    simpa only [Nat.card_eq_fintype_card] using nativeCycle_card
  simpa [hc] using h

/-- In the function-free native cycle, four vertices cannot
generate the other one. The generating rank is precisely five. -/
theorem nativeClosedCycle_not_generatedByAtMost_four :
    ¬ nativeClosedCycle.GeneratedByAtMost 4 := by
  classical
  letI : Fintype nativeCycleSet := Fintype.ofFinite nativeCycleSet
  rintro ⟨S, hcard, hgen⟩
  change nativeClosedCycle.functionClosure
    (↑S : Set nativeCycleSet) = Set.univ at hgen
  have huniv : (↑S : Set nativeCycleSet) = Set.univ :=
    (nativeClosedCycle_functionClosure_eq (↑S : Set nativeCycleSet)).symm.trans hgen
  have hS : S = Finset.univ := by
    ext x
    constructor
    · intro _
      simp
    · intro _
      change x ∈ (↑S : Set nativeCycleSet)
      rw [huniv]
      trivial
  have hCount : S.card = Nat.card nativeCycleSet := by
    rw [hS]
    simp [Nat.card_eq_fintype_card]
  have : (5 : ℕ) ≤ 4 := by
    calc
      5 = Nat.card nativeCycleSet := nativeCycle_card.symm
      _ = S.card := hCount.symm
      _ ≤ 4 := hcard
  omega

end

end StructuralRamsey.Structure.MaximalHardRootFiveCycle
