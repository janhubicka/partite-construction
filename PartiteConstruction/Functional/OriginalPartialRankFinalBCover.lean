import PartiteConstruction.Functional.OriginalPartialSmallImageGeneratorHull
import PartiteConstruction.Functional.PublishedSparseningLoose

/-!
# The final published B-copy extension preserves strict original-partial
# local tree completion once the predecessor has a generator-rank bound

The existing native functional projected-cover/final completion creates
the B-copy extension and a loose full-functional B-tree. Its EHN
projection back to the preceding Ramsey stage has the ORIGINAL 2019
partial-function semantics. A strict local completion of every CLOSED
test on n vertices follows from a generator-rank strict local invariant
at that preceding stage: the exact projected test has <= n generators,
regardless of the size of its function closure.

Thus the final B-copy coverage pass is not an additional obstruction to
the strict original-partial theorem. The genuine outstanding obligation
is to raise the generator-rank strict local invariant through mixed
native Hales--Jewett Picture steps while respecting A-intersections.
This theorem is CONDITIONAL on that predecessor invariant and is not
a proof of unconditional strict full-functional sparsening.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V P : Type v}

/-- Corrected final sparsening: if the prior genuine functional Ramsey
witness has strict original-partial completions for all closed tests
generated by at most n vertices, then one final projected-cover pass
preserves a STRICT full-functional local tree completion for every
closed n-vertex test, as well as full Ramsey and irreducible B-coverage. -/
theorem sparseningRamsey_originalPartial_strictClosed_from_generatorRank
    (K : StructureClass (L := L))
    (hK : FreeAmalgamationClass K)
    (A : Structure L U) (B : Structure L V) (D : Structure L P)
    [Finite U] [Finite V] [Finite P]
    (hA : K A) (hB : K B)
    (κ : Type*) [Fintype κ] [Nonempty κ]
    (hArrow : Arrow A B D κ)
    (n : ℕ)
    (hRank : LocallyGeneratedOriginalPartialTreeCompletable B D n) :
    ∃ (W : Type v) (_ : Finite W) (C : Structure L W),
      K C ∧
      Arrow A B C κ ∧
      (∃ p : W → P, IsOriginalPartialHomomorphismEmbedding C D p) ∧
      LocallyClosedOriginalPartialTreeCompletable B C n ∧
      IrreduciblesExtendTo B C ∧
      LooseTreeAmalgam B W C := by
  classical
  obtain ⟨W, hW, C, hCK, hCArrow, ⟨p,hp⟩,
      hLoose, hCover, _hLocalLoose⟩ :=
    sparseningRamsey_functional_looseFullTrees_inClass
      K hK A B D hA hB κ hArrow
  let hLocal : LocallyClosedOriginalPartialTreeCompletable B C n :=
    hRank.pullback_closed_vertexRank hp
  exact ⟨W, hW, C, hCK, hCArrow, ⟨p, hp.toOriginalPartial⟩,
    hLocal, hCover, hLoose⟩

end StructuralRamsey.Structure
