import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy
import PartiteConstruction.Functional.OneGeneratedRootRelativeCompletion
import PartiteConstruction.Functional.OriginalPartialIrreducibleCollarRelativeRoot

/-!
# Track D: colliding EHN root labels force a genuinely reducible hard separator

The canonical 2019/EHN projection of the EXACT full-functional common
separator in a native binary attachment may identify two different
source vertices. Such collisions are NOT excluded by maximality of
the projected GENERATOR rank of the whole test.

This module gives a strict, source-native negative gate:

* An EHN map with a literal two-vertex collision cannot have an
  irreducible source structure: on irreducible structures it is
  represented by a FULL embedding.
* A finite such source has an ACTUAL proper FULL free decomposition,
  with no graph or U-closed surrogate.
* It is not generated by at most one vertex (for any function arity).
* There is no FULL embedding of that source into an irreducible
  EHN-labelled collar whose label map agrees on the entire root.

We then instantiate the statement on the genuine closed-test
`closedTestPullback` separator and its canonical A labels.

This is NOT a proof that the reducible root has no strict
relative B-tree completion. In fact a relative completion map may
legitimately be noninjective. The result excludes only the
irreducible-collar SHORTCUT and isolates a necessary branch of
the history-dependent target-root construction.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V W : Type v}

/-- An actual collision of EHN labels prevents the FULL source
structure itself from being irreducible. The contradiction uses
the exact full embedding supplied by the EHN irreducible clause. -/
theorem IsEHNHomomorphismEmbedding.not_irreducible_of_collision
    {Root : Structure L U} {A : Structure L V}
    {p : U → V}
    (hp : Root.IsEHNHomomorphismEmbedding A p)
    (x y : U) (hxy : x ≠ y) (hEq : p x = p y) :
    ¬ Root.Irreducible := by
  intro hIrr
  obtain ⟨e, he⟩ := hp.2 Root hIrr (Embedding.id Root)
  apply hxy
  apply e.injective
  calc
    e x = p x := he x
    _ = p y := hEq
    _ = e y := (he y).symm

/-- An EHN label collision produces a true proper FULL
function-language free decomposition of the source. The finite
carrier assumption is required by the established equivalence of
irreducibility and absence of proper free decomposition. -/
theorem IsEHNHomomorphismEmbedding.proper_decomposition_of_collision
    {Root : Structure L U} {A : Structure L V}
    [Finite U] {p : U → V}
    (hp : Root.IsEHNHomomorphismEmbedding A p)
    (x y : U) (hxy : x ≠ y) (hEq : p x = p y) :
    Nonempty (ProperFreeDecomposition Root) := by
  by_contra hNone
  exact (hp.not_irreducible_of_collision x y hxy hEq)
    ((irreducible_iff_noProperFreeDecomposition Root).mpr hNone)

/-- A root with colliding canonical EHN labels is necessarily
harder than the verified one-generator case, even if its function
closure has many more vertices than its generating set. -/
theorem IsEHNHomomorphismEmbedding.not_one_generated_of_collision
    {Root : Structure L U} {A : Structure L V}
    {p : U → V}
    (hp : Root.IsEHNHomomorphismEmbedding A p)
    (x y : U) (hxy : x ≠ y) (hEq : p x = p y) :
    ¬ Root.GeneratedByAtMost 1 := by
  intro hOne
  exact hp.not_irreducible_of_collision x y hxy hEq
    (irreducible_of_one_generated Root hOne)

/-- No irreducible FULL source collar can contain BOTH colliding
root vertices while extending their canonical EHN labels into A.

This excludes the irreducible-collar repair without claiming the
actual reducible separator has no possible noninjective relative
completion over a larger strict target B-tree. -/
theorem IsEHNHomomorphismEmbedding.no_irreducible_EHN_collar_of_collision
    {Root : Structure L U} {A : Structure L V}
    {p : U → V}
    (hp : Root.IsEHNHomomorphismEmbedding A p)
    (x y : U) (hxy : x ≠ y) (hEq : p x = p y)
    {Collar : Structure L W}
    (hCollar : Collar.Irreducible)
    (r : W → V)
    (hr : Collar.IsEHNHomomorphismEmbedding A r)
    (j : Embedding Root Collar)
    (hj : ∀ z : U, r (j z) = p z) : False := by
  have hInjective : Function.Injective (r ∘ j) :=
    irreducibleEHNCollar_rootLabels_injective A hCollar r hr j
  apply hxy
  apply hInjective
  change r (j x) = r (j y)
  exact (hj x).trans (hEq.trans (hj y).symm)

end StructuralRamsey.Structure


namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {P U V W : Type v}

/-- The ACTUAL common root of a closed native full EHN attachment
has a canonical A-part map. A collision of two of its vertex
labels forces a proper FULL free decomposition of that very
separator and excludes the rank-one case.

The test is exactly the original closed source test; we do NOT
enlarge it, project its generator set injectively, or use a
surrogate relational attachment. -/
theorem closedTestPullback_common_collision_decomposes
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    [Finite V] [Finite W]
    (x y : (closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest).Common)
    (hxy : x ≠ y)
    (hCollision :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      let q : pb.Common → U :=
        (B.weakRestrict Douter hB.1 A alpha).part ∘ pb.commonMap
      q x = q y) :
    let pb := closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest
    Nonempty (ProperFreeDecomposition pb.common) ∧
      ¬ pb.common.GeneratedByAtMost 1 := by
  classical
  let pb := closedTestPullback B
    (B.support alpha.toFunctionEmbedding)
    (B.weak_support_closed Douter hB.1 A alpha)
    Dsys f Test hTest
  let q : pb.Common → U :=
    (B.weakRestrict Douter hB.1 A alpha).part ∘ pb.commonMap
  have hp : pb.common.IsEHNHomomorphismEmbedding A q :=
    closedTestPullback_common_EHN B Douter hB A alpha Dsys f Test hTest
  letI : Finite pb.Common :=
    Finite.of_injective pb.toLeft pb.toLeft.injective
  exact ⟨hp.proper_decomposition_of_collision x y hxy hCollision,
    hp.not_one_generated_of_collision x y hxy hCollision⟩

end StructuralRamsey.FunctionalPartite.Attachment
