import PartiteConstruction.Functional.FibreExactness
import PartiteConstruction.Functional.OriginalPartialSmallImageGeneratorHull
import PartiteConstruction.Functional.OccupiedAlphaControlExposure

/-!
# Track D: source-DEFINED exposed tuples have canonical FULL A roots

The source-domain classification of a maximal mixed native EHN
attachment distinguishes genuinely undefined function inputs from
defined inputs whose output value is omitted from the literal weak
test. In the DEFINED case, an independently validated structural
fact becomes useful: the full function-closed hull generated by
the tuple's input vertices is IRREDUCIBLE, irrespective of how
many vertices the closure adds or how many generators are needed.

Suppose the original source input parts all lie in one selected
FULL A-placement alpha:A↪D in the EHN control. The preimage of
alpha(A) under the WEAK EHN source projection is function-CLOSED.
Thus every vertex of the input-generated hull still projects into
alpha(A), including the omitted actual function output.

The irreducible-hull EHN condition gives a genuine FULL embedding
of that entire source input hull into D, and factoring through
alpha yields a FULL embedding into A, canonically agreeing with
the EHN projection. Composing with A↪Base supplies a canonical
single-Base root. This is a positive structural result for
arbitrary set-valued functional signatures, not a total-fibre
map at undefined tuples.

The input hull is NOT substituted for the original weak test,
nor is its vertex cardinality charged to the mixed rank. The
whole common separator need not lie inside this one input hull,
so a relative completion of the entire hard multi-generated
separator is still open.
-/

namespace StructuralRamsey.FunctionalPartite

open Structure
universe u v
variable {L : Language.{u}}
variable {P C UA VB : Type v}

/-- Every actual DEFINED native source-function tuple with all
input parts in the selected full A has an input-generated
function-closed hull which embeds FULLY into that same A.
The embedding agrees pointwise, after alpha, with the
original EHN part projection.

No generator/vertex bound or total-fibre domain reflection
is required. The irreducibility of this particular hull is
already verified by functionClosure_inputs_irreducible_of_value. -/
theorem System.definedInputHull_fullEmbedding_to_selectedA
    (B : System L P C) (D : Structure L P)
    (hB : B.WeaklyPartiteOver D)
    {A : Structure L UA}
    (alpha : Embedding A D)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → C)
    (hInputParts : ∀ i, B.part (xs i) ∈ Set.range alpha)
    {y : C} (hy : y ∈ B.toStructure.func Func xs) :
    let H := B.toStructure.functionClosure (Set.range xs)
    ∃ e : Embedding
      (B.toStructure.induce H
        (B.toStructure.functionClosure_isClosed (Set.range xs))) A,
      ∀ z : H, alpha (e z) = B.part z.1 := by
  classical
  let H : Set C := B.toStructure.functionClosure (Set.range xs)
  let hH : B.toStructure.IsClosed H :=
    B.toStructure.functionClosure_isClosed (Set.range xs)
  let Small := B.toStructure.induce H hH
  have hSmallIrr : Small.Irreducible := by
    exact functionClosure_inputs_irreducible_of_value
      B.toStructure Func xs hy
  let inc : Embedding Small B.toStructure :=
    inclusion B.toStructure H hH
  have hp : B.toStructure.IsEHNHomomorphismEmbedding D B.part := hB
  obtain ⟨g, hg⟩ := hp.2 Small hSmallIrr inc
  have hAlphaClosed : D.IsClosed (Set.range alpha) :=
    alpha.range_isClosed
  have hPreimageClosed :
      B.toStructure.IsClosed {z : C | B.part z ∈ Set.range alpha} :=
    hp.1.preimage_isClosed (Set.range alpha) hAlphaClosed
  have hArgs :
      Set.range xs ⊆ {z : C | B.part z ∈ Set.range alpha} := by
    rintro _ ⟨i, rfl⟩
    exact hInputParts i
  have hHullPart : ∀ z : H, B.part z.1 ∈ Set.range alpha := by
    intro z
    exact z.2 {c : C | B.part c ∈ Set.range alpha}
      hPreimageClosed hArgs
  have hGRange : ∀ z : H, ∃ a : UA, g z = alpha a := by
    intro z
    rw [hg z]
    exact hHullPart z
  let e : Embedding Small A :=
    g.factorThroughRange alpha hGRange
  refine ⟨e, ?_⟩
  intro z
  calc
    alpha (e z) = g z :=
      (Classical.choose_spec (hGRange z)).symm
    _ = B.part z.1 := hg z

/-- In a DEFINED source-function case the full input hull
embeds canonically into one selected A-copy of Base.
The precise EHN output part trace is still witnessed on the
entire hull, not only the tuple input vertices. -/
theorem System.definedInputHull_fullEmbedding_to_Base
    (B : System L P C) (D : Structure L P)
    (hB : B.WeaklyPartiteOver D)
    {A : Structure L UA}
    (alpha : Embedding A D)
    (Base : Structure L VB) (eAB : Embedding A Base)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → C)
    (hInputParts : ∀ i, B.part (xs i) ∈ Set.range alpha)
    {y : C} (hy : y ∈ B.toStructure.func Func xs) :
    let H := B.toStructure.functionClosure (Set.range xs)
    ∃ e : Embedding
      (B.toStructure.induce H
        (B.toStructure.functionClosure_isClosed (Set.range xs))) Base,
      ∀ z : H, ∃ a : UA,
        e z = eAB a ∧ alpha a = B.part z.1 := by
  obtain ⟨eA, hTrace⟩ :=
    B.definedInputHull_fullEmbedding_to_selectedA
      D hB alpha Func xs hInputParts hy
  refine ⟨eAB.comp eA, ?_⟩
  intro z
  exact ⟨eA z, rfl, hTrace z⟩

end StructuralRamsey.FunctionalPartite
