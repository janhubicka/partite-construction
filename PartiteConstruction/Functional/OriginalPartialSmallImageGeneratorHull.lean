import PartiteConstruction.Functional.OriginalPartialWeakImage
import PartiteConstruction.Functional.ClosedGeneratorRank

/-!
# Strict original-partial small-image transfer using GENERATORS

This is an alternative to the false assertion that every weak induced
vertex test of B has a strict full-functional B-tree completion.

For a genuinely function-closed source test S with an EHN projection p,
the exact projected set p[S] may fail to be closed. Its closure in the
previous picture D may contain many more vertices; charging that entire
closure to the published vertex-count induction is invalid.

Nevertheless its closed hull H is generated by the exact image p[S],
so H.GeneratedByAtMost |p[S]| is formally proved. The original 2019
partial-function homomorphism-embedding of S into D restricts to H,
because H is closed and contains p[S]. Thus any PREDECESSOR hypothesis
giving strict tree completion to all closed structures generated by at
most k vertices transfers to S as soon as |p[S]| <= k.

This is a valid conditional rank-based substitute for the published
small-projection case. It does NOT establish that the n-pass iteration
preserves such a generator-rank hypothesis in its mixed case.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V VB : Type v}
variable [DecidableEq V]

/-- Original-partial homomorphism-embeddings restrict their codomain to any
CLOSED set containing the entire vertex image. Weak and genuine
induction coincide on function-closed target subsets. -/
theorem IsOriginalPartialHomomorphismEmbedding.codRestrictClosed
    {A : Structure L U} {B : Structure L V} {f : U → V}
    (hf : IsOriginalPartialHomomorphismEmbedding A B f)
    (T : Set V) (hT : B.IsClosed T)
    (hRange : ∀ a : U, f a ∈ T) :
    IsOriginalPartialHomomorphismEmbedding
      A (B.induce T hT) (fun a => (⟨f a, hRange a⟩ : T)) := by
  change IsOriginalPartialHomomorphismEmbedding
    A (B.weakInduce T) (fun a => (⟨f a, hRange a⟩ : T))
  exact hf.codRestrictWeak T hRange

/-- Generator-rank local strict-tree invariant in the ORIGINAL
partial-function homomorphism-embedding convention. Unlike a vertex
cardinality bound, this counts generators of the entire CLOSED hull. -/
def LocallyGeneratedOriginalPartialTreeCompletable
    (Base : Structure L VB) (D : Structure L V) (k : ℕ) : Prop :=
  ∀ (H : Set V) (hH : D.IsClosed H),
    (D.induce H hH).GeneratedByAtMost k →
    HasOriginalPartialTreeCompletion Base (D.induce H hH)

namespace LocallyGeneratedOriginalPartialTreeCompletable

/-- Restricting the permissible generator count preserves the invariant. -/
theorem mono {Base : Structure L VB} {D : Structure L V}
    {m n : ℕ}
    (h : LocallyGeneratedOriginalPartialTreeCompletable Base D n)
    (hmn : m ≤ n) :
    LocallyGeneratedOriginalPartialTreeCompletable Base D m := by
  intro H hH hGen
  exact h H hH (hGen.mono hmn)

/-- Every strict functional B-tree satisfies the rank-based local
completion property at EVERY generator rank, via full inclusion. -/
theorem of_tree {Base : Structure L VB} {D : Structure L V}
    (hTree : TreeAmalgam Base V D) (k : ℕ) :
    LocallyGeneratedOriginalPartialTreeCompletable Base D k := by
  intro H hH _
  let e : Embedding (D.induce H hH) D := inclusion D H hH
  exact ⟨V, D, hTree, e, e.isEHNHomomorphismEmbedding.toOriginalPartial⟩

/-- In particular the unmodified Base itself satisfies the initial
rank-zero invariant, without any closure cardinality bound. -/
theorem base (Base : Structure L VB) (k : ℕ) :
    LocallyGeneratedOriginalPartialTreeCompletable Base Base k := by
  classical
  exact of_tree (TreeAmalgam.copy (Embedding.id Base)
    (fun b => ⟨b, rfl⟩)) k

end LocallyGeneratedOriginalPartialTreeCompletable

/-- Every closed source test has an original-partial EHN map into the
GENUINE closed hull of its exact projected vertex set. Crucially this
hull has a generator bound equal to the cardinality of the raw image,
regardless of how many new closure vertices it contains. -/
theorem IsEHNHomomorphismEmbedding.closedTestToHullRank
    {C : Structure L U} {D : Structure L V} {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (S : Finset U) (hS : C.IsClosed (↑S : Set U))
    (k : ℕ)
    (hImage : (S.image p).card ≤ k) :
    ∃ (H : Set V) (hH : D.IsClosed H) (pH : ↥(↑S : Set U) → H),
      IsOriginalPartialHomomorphismEmbedding
        (C.induce (↑S : Set U) hS) (D.induce H hH) pH ∧
      (D.induce H hH).GeneratedByAtMost k := by
  classical
  let Image : Finset V := S.image p
  let H : Set V := D.functionClosure (↑Image : Set V)
  have hH : D.IsClosed H := D.functionClosure_isClosed (↑Image : Set V)
  let pH : (↑S : Set U) → H :=
    fun x => ⟨p x.1,
      D.subset_functionClosure (↑Image : Set V)
        (Finset.mem_image.mpr ⟨x.1, x.2, rfl⟩)⟩
  have hpSmall : (C.induce (↑S : Set U) hS).IsEHNHomomorphismEmbedding
      D (p ∘ Subtype.val) :=
    hp.comp (inclusion C (↑S : Set U) hS).isEHNHomomorphismEmbedding
  have hpHull : IsOriginalPartialHomomorphismEmbedding
      (C.induce (↑S : Set U) hS) (D.induce H hH) pH :=
    hpSmall.toOriginalPartial.codRestrictClosed H hH
      (fun x => D.subset_functionClosure (↑Image : Set V)
        (Finset.mem_image.mpr ⟨x.1, x.2, rfl⟩))
  have hGenerated : (D.induce H hH).GeneratedByAtMost k :=
    (D.functionClosure_finset_generatedByAtMost Image).mono
      (show Image.card ≤ k from hImage)
  exact ⟨H, hH, pH, hpHull, hGenerated⟩

/-- Correct STRICT full-functional small-image conclusion under a generator
bound at the predecessor. The test S is genuinely CLOSED; its projection
is measured by the EXACT vertex set p[S], not by its closure cardinality.
The target completion map is partial in the 2019 sense.

The extra predecessor generator-rank assumption is essential; ordinary
n-vertex local completion of D cannot simply be applied to a much
larger closed hull, and strict completion of all weak images is false. -/
theorem HasOriginalPartialTreeCompletion.of_closed_EHN_smallImage_generatorRank
    {Base : Structure L VB} {C : Structure L U}
    {D : Structure L V} {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (S : Finset U) (hS : C.IsClosed (↑S : Set U))
    (k : ℕ) (hImage : (S.image p).card ≤ k)
    (hD : ∀ (H : Set V) (hH : D.IsClosed H),
      (D.induce H hH).GeneratedByAtMost k →
      HasOriginalPartialTreeCompletion Base (D.induce H hH)) :
    HasOriginalPartialTreeCompletion Base
      (C.induce (↑S : Set U) hS) := by
  obtain ⟨H,hH,pH,hpHull,hRank⟩ :=
    hp.closedTestToHullRank S hS k hImage
  exact (hD H hH hRank).pullback hpHull

/-- Repackaging of the verified strict small-image transfer in the
explicit generator-rank local-invariant language. The mixed Picture
preservation of this invariant is still the outstanding step. -/
theorem LocallyGeneratedOriginalPartialTreeCompletable.pullback_closed_smallImage
    {Base : Structure L VB} {C : Structure L U}
    {D : Structure L V} {p : U → V}
    {k : ℕ}
    (hD : LocallyGeneratedOriginalPartialTreeCompletable Base D k)
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (S : Finset U) (hS : C.IsClosed (↑S : Set U))
    (hImage : (S.image p).card ≤ k) :
    HasOriginalPartialTreeCompletion Base (C.induce (↑S : Set U) hS) := by
  exact HasOriginalPartialTreeCompletion.of_closed_EHN_smallImage_generatorRank
    hp S hS k hImage hD


/-- The desired VERTEX-count local strict full-functional conclusion,
restricted to genuinely function-closed tests and homomorphism-embeddings
in the original 2019 partial-function convention. -/
def LocallyClosedOriginalPartialTreeCompletable
    (Base : Structure L VB) (C : Structure L U) (n : ℕ) : Prop :=
  ∀ (S : Finset U), S.card ≤ n →
    ∀ hS : C.IsClosed (↑S : Set U),
      HasOriginalPartialTreeCompletion Base (C.induce (↑S : Set U) hS)

/-- An arbitrary EHN projection to a rank-n strict target already implies
the desired vertex-n strict local property in the SOURCE. In particular,
this works through the final full-functional B-copy attachment, once the
n-pass preceding picture has the stronger generator-rank invariant. -/
theorem LocallyGeneratedOriginalPartialTreeCompletable.pullback_closed_vertexRank
    {Base : Structure L VB} {C : Structure L U}
    {D : Structure L V} {p : U → V} {n : ℕ}
    (hD : LocallyGeneratedOriginalPartialTreeCompletable Base D n)
    (hp : C.IsEHNHomomorphismEmbedding D p) :
    LocallyClosedOriginalPartialTreeCompletable Base C n := by
  intro S hCard hS
  have hImage : (S.image p).card ≤ n :=
    (Finset.card_image_le).trans hCard
  exact hD.pullback_closed_smallImage hp S hS hImage


end StructuralRamsey.Structure
