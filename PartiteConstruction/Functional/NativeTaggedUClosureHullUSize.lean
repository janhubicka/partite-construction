import PartiteConstruction.Functional.OutputPartSingletonUClosedBridge
import PartiteConstruction.Ramsey.ClosureGeneratedHullRank
import PartiteConstruction.Functional.ClosedGeneratorRank

/-!
# Exact native function-closure hull = canonical 2019 U-closure hull

Let B be a genuine finite multivalued transversal functional partite
system in a positive-arity function language. Form the per-output-part
singleton split B^P and its canonical full-input-pattern tagged
relational expansion E, with the original 2019 closure rules U.

For EVERY exact vertex subset S on the same original carrier:

  B.toStructure.functionClosure S = UClosureHull U E S.

This is a literal identity of closure operators: closed subsets of
the original multivalued source are EXACTLY relative U-substructures
of the canonical tagged split. There is no replacement of weak S by
a generated hull in the finite-size induction.

Consequently native generation by S coincides with U-generation
by the SAME S; in particular the minimum number of vertices needed
to generate all of B is exactly the 2019 USize of canonical E.

The latter does NOT equate the vertex cardinal of a closure hull
with the number of its generators, or compare different weak-induced
structures' intrinsic USize. Target strict functional B-tree
completion remains a separate history-dependent obligation.
-/

namespace StructuralRamsey.FunctionalPartite

open StructuralRamsey.Structure
open StructuralRamsey.RelStructure

universe u v w
variable {L : Language.{u}} {P : Type v} {V : Type w}

/-- The original multivalued native functional closure of an EXACT
source vertex subset equals the RELATIVE 2019 U-closure hull in
the canonical singleton-output/full-pattern tagged language.

This holds simultaneously for every possible input set S.
All values in ALL primitive output parts contribute; no
function-closure or new rank vertices are inserted. -/
theorem System.functionClosure_eq_taggedUClosureHull
    (B : System L P V) [Finite V]
    (hPos : L.PositiveFuncArity) (S : Set V) :
    B.toStructure.functionClosure S =
      RelStructure.UClosureHull
        (L.outputPartIndexed P).patternClosureRules
        (RelStructure.patternTagExpansion
          (B.splitOutputParts).toStructure.patternGraph) S := by
  let E := RelStructure.patternTagExpansion
    (B.splitOutputParts).toStructure.patternGraph
  have hClosedEquiv (T : Set V) :
      B.toStructure.IsClosed T ↔
        RelStructure.IsUSubstructure
          (L.outputPartIndexed P).patternClosureRules E T :=
    (B.isClosed_iff_splitOutputParts_isClosed T).trans
      (Structure.isClosed_iff_taggedPattern_isUSubstructure
        (B.splitOutputParts).toStructure hPos.outputPartIndexed T)
  ext x
  change
    (∀ T : Set V, B.toStructure.IsClosed T → S ⊆ T → x ∈ T) ↔
      (∀ T : Set V,
        RelStructure.IsUSubstructure
          (L.outputPartIndexed P).patternClosureRules E T →
        S ⊆ T → x ∈ T)
  constructor
  · intro hx T hT hST
    exact hx T ((hClosedEquiv T).mpr hT) hST
  · intro hx T hT hST
    exact hx T ((hClosedEquiv T).mp hT) hST

/-- EXACT same generating seed subset in the genuine native
multivalued structure and in its canonical 2019 tagged
singleton-output part presentation. -/
theorem System.generatedBy_iff_taggedUGenerating
    (B : System L P V) [Finite V]
    (hPos : L.PositiveFuncArity) (S : Set V) :
    B.toStructure.GeneratedBy S ↔
      RelStructure.IsUGenerating
        (L.outputPartIndexed P).patternClosureRules
        (RelStructure.patternTagExpansion
          (B.splitOutputParts).toStructure.patternGraph) S := by
  change B.toStructure.functionClosure S = Set.univ ↔
    RelStructure.UClosureHull
      (L.outputPartIndexed P).patternClosureRules
      (RelStructure.patternTagExpansion
        (B.splitOutputParts).toStructure.patternGraph) S = Set.univ
  rw [B.functionClosure_eq_taggedUClosureHull hPos S]

/-- For every finite n, the ORIGINAL native multivalued system
can be generated by at most n literal vertices iff the
canonical 2019 USize of the tagged singleton presentation
is at most n.

The witness generator Finset is unchanged. The closure
hull itself may contain far MORE than n vertices. -/
theorem System.generatedByAtMost_iff_taggedUSize_le
    (B : System L P V) [Fintype V]
    (hPos : L.PositiveFuncArity) (n : ℕ) :
    B.toStructure.GeneratedByAtMost n ↔
      RelStructure.USize
        (L.outputPartIndexed P).patternClosureRules
        (RelStructure.patternTagExpansion
          (B.splitOutputParts).toStructure.patternGraph) ≤ n := by
  let E := RelStructure.patternTagExpansion
    (B.splitOutputParts).toStructure.patternGraph
  let rules := (L.outputPartIndexed P).patternClosureRules
  constructor
  · rintro ⟨G, hG, hGen⟩
    have hU : RelStructure.IsUGenerating rules E (↑G : Set V) :=
      (B.generatedBy_iff_taggedUGenerating hPos (↑G : Set V)).mp hGen
    exact (RelStructure.USize_le_of_generating rules E G hU).trans hG
  · intro h
    obtain ⟨G, hCard, hGen⟩ :=
      RelStructure.USize_spec rules E
    have hBound : G.card ≤ n := by
      rw [hCard]
      exact h
    exact ⟨G, hBound,
      (B.generatedBy_iff_taggedUGenerating hPos (↑G : Set V)).mpr hGen⟩

end StructuralRamsey.FunctionalPartite
