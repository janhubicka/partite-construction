import PartiteConstruction.Functional.OneGeneratorFreeAmalgam
import PartiteConstruction.Functional.EHNNativeOriginalPartialMaximalMixedReduction
import PartiteConstruction.Functional.EHNOriginalPartialGeneratorPictureReduction
import PartiteConstruction.Functional.OriginalPartialRankFinalBCover
import PartiteConstruction.Functional.OriginalPartialRankZero

/-!
# Complete strict original-partial native functional sparsening at rank ONE

A genuinely mixed closed test of rank 1 cannot occur in the actual
binary Hales-Jewett attachment: the exact functional closed-test
pullback is a FULL free amalgam, and any structure generated by <=1
vertex lies in one constituent side (verified independent free-amalgam
theorem).

Thus the mixed relative-tree-extension premise of the corrected
strict generator-rank iteration is automatically discharged at rank 1,
regardless of the reducibility of the common root.

The original Ramsey arrow supplies an actual B -> D placement for
the rank-zero starting picture. The verified native functional
Hales-Jewett power, finite Picture and induced Ramsey construction
then give the first full function-language Ramsey pass with STRICT
original-partial B-tree completions of all closed 1-generated tests.
The verified final B-coverage pass preserves strict completions of
closed tests on at most one vertex.

No total-fibre homomorphism, all-weak strict completion, or U-closed
relational replay is asserted. For ranks >=2 the compatible
maximal-mixed relative B-tree extension lemma remains open.
-/

namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure
noncomputable section
universe u v
variable {L : Language.{u}}
variable {P V W VB : Type v}

/-- In the EXACT closed-test pullback of a native full-functional binary
attachment, a closed one-generated test is wholly contained in its
genuine core or wholly in the one attached old copy. -/
theorem nativeClosedTest_rankOne_pure
    (B : System L P V) (S : Set V)
    (hS : B.toStructure.IsClosed S)
    (D : System L P W)
    (f : FunctionalPartite.Embedding (B.induce S hS) D)
    (Test : Set (Structure.Attachment.Vertex S
      (W := W) (I := PUnit.{v+1})))
    (hTest : (UnitAttachD B S hS D f).toStructure.IsClosed Test)
    (hGen : ((UnitAttachD B S hS D f).toStructure.induce
      Test hTest).GeneratedByAtMost 1) :
    (∀ x : Test, ∃ w : W, x.1 = unitCoreEmbedding B S hS D f w) ∨
    (∀ x : Test, ∃ v : V, x.1 = unitCopyEmbedding B S hS D f v) := by
  let pb := closedTestPullback B S hS D f Test hTest
  rcases pb.free.one_generated_source_contained_in_side hGen with hL | hR
  · left
    intro x
    obtain ⟨a,ha⟩ := hL x
    refine ⟨pb.leftMap a, ?_⟩
    calc
      x.1 = (pb.leftIn a).1 := congrArg Subtype.val ha
      _ = unitCoreEmbedding B S hS D f (pb.leftMap a) :=
        pb.left_factor a
  · right
    intro x
    obtain ⟨a,ha⟩ := hR x
    refine ⟨pb.rightMap a, ?_⟩
    calc
      x.1 = (pb.rightIn a).1 := congrArg Subtype.val ha
      _ = unitCopyEmbedding B S hS D f (pb.rightMap a) :=
        pb.right_factor a

/-- The rooted B-tree extension premise for genuinely mixed one-generated
closed tests is VACUOUS, with arbitrary closed support and any function
arity. No root-isolation or projection assumption is necessary. -/
theorem nativeMixed_rankOne_vacuous
    (B : System L P V) (S : Set V)
    (hS : B.toStructure.IsClosed S)
    (D : System L P W)
    (f : FunctionalPartite.Embedding (B.induce S hS) D)
    (Base : Structure L VB) :
    NativeMixedOriginalPartialRelativeExtension B S hS D f Base 1 := by
  intro Test hTest hGen hNotCore hNotCopy
  rcases nativeClosedTest_rankOne_pure B S hS D f
      Test hTest hGen with hCore | hCopy
  · exact (hNotCore hCore).elim
  · exact (hNotCopy hCopy).elim

/-- Sharper maximal-projected-generator version of the same rank-one
vacuity, the exact interface of the complete native Ramsey pass. -/
theorem nativeMaximalMixed_rankOne_vacuous
    (B : System L P V) (S : Set V)
    (hS : B.toStructure.IsClosed S)
    (D : System L P W)
    (f : FunctionalPartite.Embedding (B.induce S hS) D)
    (Base : Structure L VB) [DecidableEq P] :
    NativeMaximalMixedOriginalPartialRelativeExtension
      B S hS D f Base 1 := by
  intro Test hTest G hGen hCard _hImage hNotCore hNotCopy
  have hOne : ((UnitAttachD B S hS D f).toStructure.induce
      Test hTest).GeneratedByAtMost 1 :=
    ⟨G,hCard,hGen⟩
  rcases nativeClosedTest_rankOne_pure B S hS D f
      Test hTest hOne with hCore | hCopy
  · exact (hNotCore hCore).elim
  · exact (hNotCopy hCopy).elim

/-- The genuine binary functional attachment ALWAYS preserves local
strict original-partial rank ONE B-tree completability when both
constituent sides do. The higher-rank mixed-step oracle is unnecessary. -/
theorem nativeAttach_rankOne_strict
    (B : System L P V) (S : Set V)
    (hS : B.toStructure.IsClosed S)
    (D : System L P W)
    (f : FunctionalPartite.Embedding (B.induce S hS) D)
    (Base : Structure L VB)
    (hCore : LocallyGeneratedOriginalPartialTreeCompletable
      Base D.toStructure 1)
    (hCopy : LocallyGeneratedOriginalPartialTreeCompletable
      Base B.toStructure 1) :
    LocallyGeneratedOriginalPartialTreeCompletable
      Base (UnitAttachD B S hS D f).toStructure 1 := by
  exact nativeAttach_generatorRank_of_mixed_relative_extensions
    B S hS D f Base 1 hCore hCopy
    (nativeMixed_rankOne_vacuous B S hS D f Base)

end
end StructuralRamsey.FunctionalPartite.Attachment

namespace StructuralRamsey.FunctionalPartite.EHN

open StructuralRamsey.Structure
noncomputable section
universe u v
variable {L : Language.{u}}
variable {P U V : Type v}
variable {K : Structure.StructureClass (L := L)}

/-- An UNCONDITIONAL first strict original-partial native functional
Ramsey pass. The rank-zero starting invariant follows from B -> D,
and all genuine binary attachments preserve rank-one strict trees
by their exact closed free-amalgam structure. -/
theorem inducedConstruction_originalPartial_generatorRank_one
    (hK : Structure.FreeAmalgamationClass K)
    (A : Structure L U) (Base : Structure L V) (D : Structure L P)
    [Finite U] [Finite V] [Finite P]
    (hKA : K A) (hKB : K Base)
    (hBIrr : Base.Irreducible)
    (hPos : L.PositiveFuncArity)
    (eAB : Structure.Embedding A Base)
    (κ : Type*) [Fintype κ] [Nonempty κ]
    (hArrow : Structure.Arrow A Base D κ) :
    ∃ T : Stage K D,
      LocallyGeneratedOriginalPartialTreeCompletable
        Base T.system.toStructure 1 ∧
      Structure.Arrow A Base T.system.toStructure κ := by
  classical
  have hZero : LocallyGeneratedOriginalPartialTreeCompletable
      Base D 0 := by
    intro H hH hGen
    exact closed_rank_zero_originalPartial_completion_of_arrow
      A Base D hPos κ hArrow H hH hGen
  exact inducedConstruction_originalPartial_generatorRank_of_maximal_mixed
    hK A Base D hKA hKB hBIrr hPos eAB κ hArrow 1 hZero
    (fun Old T alpha f hOld hCore =>
      Attachment.nativeMaximalMixed_rankOne_vacuous
        Old.system (Old.system.support alpha.toFunctionEmbedding)
        (Old.system.weak_support_closed D Old.isPartite.1 A alpha)
        T.system f Base)

/-- Strict FUNCTIONAL local-tree sparsening at n=1, with full Ramsey
embeddings, a genuine final B-extension, and ORIGINAL partial-function
homomorphism-embedding projection. No maximal mixed-root schema remains
at this rank. The target B-trees are full and strict (not graph trees). -/
theorem sparsening_originalPartial_strict_one
    (K : Structure.StructureClass (L := L))
    (hK : Structure.FreeAmalgamationClass K)
    (A : Structure L U) (Base : Structure L V) (D : Structure L P)
    [Finite U] [Finite V] [Finite P]
    (hKA : K A) (hKB : K Base)
    (hBIrr : Base.Irreducible)
    (hPos : L.PositiveFuncArity)
    (eAB : Structure.Embedding A Base)
    (κ : Type*) [Fintype κ] [Nonempty κ]
    (hArrow : Structure.Arrow A Base D κ) :
    ∃ (W : Type v) (_ : Finite W) (C : Structure L W),
      K C ∧
      Structure.Arrow A Base C κ ∧
      (∃ p : W → P, IsOriginalPartialHomomorphismEmbedding C D p) ∧
      LocallyClosedOriginalPartialTreeCompletable Base C 1 ∧
      IrreduciblesExtendTo Base C ∧
      LooseTreeAmalgam Base W C := by
  classical
  obtain ⟨T, hRank, hTArrow⟩ :=
    inducedConstruction_originalPartial_generatorRank_one
      hK A Base D hKA hKB hBIrr hPos eAB κ hArrow
  obtain ⟨W, hW, C, hKC, hCArrow, ⟨q,hq⟩,
      hLocal, hCover, hLoose⟩ :=
    sparseningRamsey_originalPartial_strictClosed_from_generatorRank
      K hK A Base T.system.toStructure hKA hKB κ hTArrow 1 hRank
  have hp : IsOriginalPartialHomomorphismEmbedding
      C D (T.system.part ∘ q) :=
    T.isPartite.toOriginalPartial.comp hq
  exact ⟨W, hW, C, hKC, hCArrow,
    ⟨T.system.part ∘ q, hp⟩, hLocal, hCover, hLoose⟩

end
end StructuralRamsey.FunctionalPartite.EHN
