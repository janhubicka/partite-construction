import PartiteConstruction.Functional.OriginalPartialRelativeAppend

/-!
# Strict original-partial completion along a fixed central anchor

The genuine functional Hales--Jewett Picture is assembled by attaching
old-stage copies along subsets of one distinguished power core. The
previous relative-append theorem was phrased using a fresh relative
right-side completion over the ALREADY COMPLETED left target.

For a star attachment this unnecessary moving-target hypothesis can
be replaced by a fixed relative completion in the SAME original Start.
Indeed the common separator of the new attachment factors through
the preserved central Anchor, and the old left-side completion agrees
with the original anchor map. Rebase the new right-side witness to the
currently completed left target using the already verified replayFree
lemma, then apply relative append.

This makes the essential induction invariant closer to the original
published Appendix A. It is entirely in the genuine function language
and uses the original 2019 partial-function homomorphism-embedding.

An old-copy relative extension over the FIXED canonical root map is
still required: this theorem does not create it from an arbitrary
unrooted strict tree completion, and does not prove the maximal
multi-generated mixed-root schema.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {H0 H E F Z VB G : Type v}

/-- Star-attachment preservation of a canonical anchored strict
full-functional B-tree completion.

The common source root of the NEXT attachment lies in the distinguished
old core Anchor (the factorization `rootInAnchor`). If the current
left picture and the incoming right copy BOTH have strict relative
completions over the *same fixed* Start, agreeing with the same
canonical anchor map `q`, then so does their full free amalgam.

No fresh `∀`-quantified right witness over each possible completed
left tree is necessary: `HasOriginalPartialTreeExtensionCompletion.rebase`
automatically moves the fixed right witness to the chosen left target.
The common root need not be irreducible, injectively projected, or
generated by one vertex. -/
theorem IsFreeAmalgam.originalPartialTreeExtension_append_over_anchor
    {Anchor : Structure L H0}
    {Root : Structure L H}
    {Left : Structure L E} {Right : Structure L F}
    {Whole : Structure L Z}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hSrc : IsFreeAmalgam sL sR iL iR)
    (Base : Structure L VB)
    (Start : Structure L G)
    (anchor : Embedding Anchor Left)
    (q : H0 → G)
    (rootInAnchor : Embedding Root Anchor)
    (hFactor : ∀ x : H, sL x = anchor (rootInAnchor x))
    (hOld : HasOriginalPartialTreeExtensionCompletion
      (Start := Start) Base anchor q)
    (hCopy : HasOriginalPartialTreeExtensionCompletion
      (Start := Start) Base sR (q ∘ rootInAnchor)) :
    HasOriginalPartialTreeExtensionCompletion
      (Start := Start) Base (iL.comp anchor) q := by
  obtain ⟨YL, TLeft, hLeftExt, pLeft, hpLeft, hAnchor⟩ := hOld
  have hRootMaps :
      (pLeft ∘ sL) =
      (hLeftExt.startEmbedding ∘ (q ∘ rootInAnchor)) := by
    funext x
    change pLeft (sL x) =
      hLeftExt.startEmbedding (q (rootInAnchor x))
    rw [hFactor x]
    exact hAnchor (rootInAnchor x)
  have hRightOverLeft : HasOriginalPartialTreeExtensionCompletion
      (Start := TLeft) Base sR (pLeft ∘ sL) := by
    rw [hRootMaps]
    exact HasOriginalPartialTreeExtensionCompletion.rebase
      sR (q ∘ rootInAnchor) hCopy hLeftExt
  exact hSrc.originalPartialTreeExtension_append
    Base Start anchor q TLeft hLeftExt pLeft hpLeft hAnchor
    hRightOverLeft

end StructuralRamsey.Structure
