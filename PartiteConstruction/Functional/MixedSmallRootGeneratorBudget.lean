import PartiteConstruction.Functional.FreeAmalgamGeneratorBudget

/-!
# Strict generator-rank budgets at genuinely mixed small-root attachments

A full function-language free amalgam generated by n vertices may
gain up to |Root| extra generators when restricted to a side.
But for a GENUINELY mixed test at least one generating vertex lies
outside each side, so the side generator set drops by one.

Consequently, if the common full-functional root has at most one
vertex, both closed constituent sides retain the SAME n-generator
budget. Functions of arbitrary arity are allowed: the proof uses
only that each side's range is function-closed and incidences
cannot cross a free amalgam.

This is a reusable strengthening of
IsFreeAmalgam.left_generatedByAtMost_add_root, not a claim that
every mixed test loses rank without an additional small-root
hypothesis. Nonempty reducible roots with ≥2 vertices remain open.
-/

namespace StructuralRamsey.Structure.IsFreeAmalgam

universe u v
variable {L : Language.{u}}
variable {H E F C : Type v}
variable {Root : Structure L H}
variable {Left : Structure L E}
variable {Right : Structure L F}
variable {Whole : Structure L C}
variable {sL : Embedding Root Left}
variable {sR : Embedding Root Right}
variable {iL : Embedding Left Whole}
variable {iR : Embedding Right Whole}

/-- If a mixed n-generated full functional free amalgam has a common
root of cardinality at most one, the LEFT side is n-generated.
The proof explicitly omits an outside-left generator from its
generator count, then adds at most one root vertex. -/
theorem left_generatedByAtMost_of_mixed_small_root
    [Finite H] [Finite E]
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hNotLeft : ¬ ∀ x : C, ∃ a : E, x = iL a)
    (hRootSmall : Nat.card H ≤ 1)
    {n : ℕ}
    (hgen : Whole.GeneratedByAtMost n) :
    Left.GeneratedByAtMost n := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype E := Fintype.ofFinite E
  rcases hgen with ⟨G, hGcard, hGgen⟩

  have hOutsideGen : ∃ g : C, g ∈ G ∧ g ∉ Set.range iL := by
    by_contra hn
    apply hNotLeft
    intro z
    have hSeed : (↑G : Set C) ⊆ Set.range iL := by
      intro y hy
      by_contra hyOut
      exact hn ⟨y, hy, hyOut⟩
    have hz : z ∈ Whole.functionClosure (↑G : Set C) := by
      rw [hGgen]
      exact Set.mem_univ z
    obtain ⟨a, ha⟩ := hz (Set.range iL) iL.range_isClosed hSeed
    exact ⟨a, ha.symm⟩
  obtain ⟨g, hgG, hgOut⟩ := hOutsideGen

  let leftGen : Finset E :=
    (Finset.univ : Finset E).filter (fun x => iL x ∈ G)
  let rootGen : Finset E :=
    (Finset.univ : Finset H).image sL
  let generators : Finset E := leftGen ∪ rootGen

  have hLeftGenCard : leftGen.card + 1 ≤ G.card := by
    let phi : ↥(↑leftGen : Set E) → ↥(↑(G.erase g) : Set C) :=
      fun x => ⟨iL x.1, by
        apply Finset.mem_erase.mpr
        constructor
        · intro hx
          exact hgOut ⟨x.1, hx⟩
        · exact (Finset.mem_filter.mp x.2).2⟩
    have hphi : Function.Injective phi := by
      intro x y hxy
      apply Subtype.ext
      apply iL.injective
      exact congrArg Subtype.val hxy
    have hle : leftGen.card ≤ (G.erase g).card := by
      calc
        leftGen.card = Fintype.card ↥(↑leftGen : Set E) := by simp
        _ ≤ Fintype.card ↥(↑(G.erase g) : Set C) :=
          Fintype.card_le_of_injective phi hphi
        _ = (G.erase g).card := by simp
    have hErase : (G.erase g).card = G.card - 1 :=
      Finset.card_erase_of_mem hgG
    have hPos : 0 < G.card := Finset.card_pos.mpr ⟨g, hgG⟩
    omega

  have hRootGenCard : rootGen.card ≤ Nat.card H := by
    simpa [rootGen, Nat.card_eq_fintype_card] using
      (Finset.card_image_le
        (s := (Finset.univ : Finset H)) (f := sL))

  refine ⟨generators, ?_, ?_⟩
  · calc
      generators.card ≤ leftGen.card + rootGen.card :=
        Finset.card_union_le _ _
      _ ≤ G.card := by omega
      _ ≤ n := hGcard
  · ext x
    constructor
    · intro _
      simp
    · intro _
      intro T hT hGeneratorsT

      let TWhole : Set C :=
        Set.range iR ∪ iL '' T

      have hCommonT : ∀ d : H, sL d ∈ T := by
        intro d
        apply hGeneratorsT
        apply Finset.mem_union_right
        exact Finset.mem_image.mpr ⟨d, Finset.mem_univ d, rfl⟩

      have hTWholeClosed : Whole.IsClosed TWhole := by
        intro F0 args hargs y hy
        rcases (hfree.func_iff F0 args y).mp hy with
          hleft | hright
        · rcases hleft with ⟨a, b, hb, hargsEq, hyEq⟩
          have haT : ∀ k, a k ∈ T := by
            intro k
            have hk : iL (a k) ∈ TWhole := by
              have hk0 := hargs k
              rw [hargsEq] at hk0
              exact hk0
            rcases hk with hR | hL
            · rcases hR with ⟨r, hr⟩
              obtain ⟨d, had, _⟩ :=
                (hfree.overlap (a k) r).mp hr.symm
              rw [had]
              exact hCommonT d
            · rcases hL with ⟨a', ha'T, ha'eq⟩
              have haa : a' = a k := iL.injective ha'eq
              simpa [haa] using ha'T
          have hbT : b ∈ T := hT F0 a haT hb
          exact Or.inr ⟨b, hbT, hyEq.symm⟩
        · rcases hright with ⟨a, b, hb, hargsEq, hyEq⟩
          exact Or.inl ⟨b, hyEq.symm⟩

      have hGTWhole : (↑G : Set C) ⊆ TWhole := by
        intro g hg
        rcases hfree.covers g with ⟨l, hgl⟩ | ⟨r, hgr⟩
        · have hlLeftGen : l ∈ leftGen := by
            apply Finset.mem_filter.mpr
            exact ⟨Finset.mem_univ l, by simpa [hgl] using hg⟩
          have hlT : l ∈ T := by
            apply hGeneratorsT
            exact Finset.mem_union_left rootGen hlLeftGen
          exact Or.inr ⟨l, hlT, hgl.symm⟩
        · exact Or.inl ⟨r, hgr.symm⟩

      have hxWhole : iL x ∈ TWhole := by
        have hxClosure : iL x ∈ Whole.functionClosure (↑G : Set C) := by
          rw [hGgen]
          simp
        exact hxClosure TWhole hTWholeClosed hGTWhole

      rcases hxWhole with hR | hL
      · rcases hR with ⟨r, hr⟩
        obtain ⟨d, hxd, _⟩ :=
          (hfree.overlap x r).mp hr.symm
        rw [hxd]
        exact hCommonT d
      · rcases hL with ⟨l, hlT, hleq⟩
        have hlx : l = x := iL.injective hleq
        simpa [hlx] using hlT

/-- Both genuine sides inherit the SAME n-generator budget when
the actual root contains at most one vertex and the full source
meets each side's exterior. -/
theorem sides_generatedByAtMost_of_mixed_small_root
    [Finite H] [Finite E] [Finite F]
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hNotLeft : ¬ ∀ x : C, ∃ a : E, x = iL a)
    (hNotRight : ¬ ∀ x : C, ∃ b : F, x = iR b)
    (hRootSmall : Nat.card H ≤ 1)
    {n : ℕ} (hgen : Whole.GeneratedByAtMost n) :
    Left.GeneratedByAtMost n ∧ Right.GeneratedByAtMost n := by
  constructor
  · exact hfree.left_generatedByAtMost_of_mixed_small_root
      hNotLeft hRootSmall hgen
  · exact hfree.swap.left_generatedByAtMost_of_mixed_small_root
      hNotRight hRootSmall hgen

end StructuralRamsey.Structure.IsFreeAmalgam
