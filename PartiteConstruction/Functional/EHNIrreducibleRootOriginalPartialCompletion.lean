import PartiteConstruction.Functional.OriginalPartialIrreducibleRootRelativeWitness
import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy
import PartiteConstruction.Functional.OriginalPartialSmallImageGeneratorHull

/-!
# Actual native EHN mixed closed test with irreducible separator

The root of the EXACT full-functional closed-test pullback of a native
EHN binary attachment has the canonical original-partial EHN
projection into the selected A. When the closed common separator is
irreducible, this projection is represented by a FULL embedding into A.

The prescribed A ↪ Base therefore gives a full embedding of the actual
root into Base. At the same time, if the two genuine closed pullback
sides are generated by at most n vertices, the existing strict
generator-rank local-tree invariants for the core and old copy provide
absolute original-2019 strict B-tree completions of those sides.

The irreducible-root synchronization theorem then constructs compatible
relative completions over that one prescribed Base copy and glues them.
No additional root-isolation or independent matching of side completions
is assumed; no graph decoder or U-closed recursion is used.

The side generator-rank bounds are EXPLICIT. They do NOT follow for an
arbitrary maximal mixed test merely because the entire test is
n-generated; common-root generators may increase those budgets.
Reducible common separators and missing generator budget estimates
remain the genuine outstanding mixed-induction cases.
-/

namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure
universe u v
variable {L : Language.{u}}
variable {P U V W VB : Type v}

/-- Verified strict original-partial full-functional completion of an
actual native mixed closed test when its common separator is
irreducible and both closed pullback sides fit the current generator
budget. Side tree witnesses need NOT arrive with compatible roots:
that compatibility is built by strict B-copy attachment. -/
theorem closedTest_originalPartial_irreducibleRoot_of_sideRanks
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (Base : Structure L VB)
    (hBase : Base.Irreducible)
    (eAB : Structure.Embedding A Base)
    (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    (n : ℕ)
    (hCore : LocallyGeneratedOriginalPartialTreeCompletable
      Base Dsys.toStructure n)
    (hCopy : LocallyGeneratedOriginalPartialTreeCompletable
      Base B.toStructure n)
    (hRoot :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.common.Irreducible)
    (hLeftRank :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.left.GeneratedByAtMost n)
    (hRightRank :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.right.GeneratedByAtMost n) :
    HasOriginalPartialTreeCompletion Base
      ((UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.induce Test hTest) := by
  let Supp := B.support alpha.toFunctionEmbedding
  let hSupp := B.weak_support_closed Douter hB.1 A alpha
  let pb := closedTestPullback B Supp hSupp Dsys f Test hTest
  let WR := B.weakRestrict Douter hB.1 A alpha
  have hRootEHN : pb.common.IsEHNHomomorphismEmbedding A
      (WR.part ∘ pb.commonMap) :=
    closedTestPullback_common_EHN
      B Douter hB A alpha Dsys f Test hTest
  obtain ⟨qA, _hqA⟩ :=
    hRootEHN.2 pb.common hRoot (Structure.Embedding.id pb.common)
  let q : Structure.Embedding pb.common Base := eAB.comp qA
  have hLeft : HasOriginalPartialTreeCompletion Base pb.left :=
    hCore.completion_of_embedding pb.left hLeftRank pb.leftMap
  have hRight : HasOriginalPartialTreeCompletion Base pb.right :=
    hCopy.completion_of_embedding pb.right hRightRank pb.rightMap
  exact pb.free.originalPartialTreeCompletion_of_irreducible_root
    Base hBase hRoot q hLeft hRight

end StructuralRamsey.FunctionalPartite.Attachment
