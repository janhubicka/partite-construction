import PartiteConstruction.Functional.OriginalPartialSmallImageGeneratorHull

/-!
# Correct published two-case split for functional generated closed tests

For RELATIONAL test vertex sets, equality of source and projected
cardinalities makes the entire projection injective. In the genuine
set-valued function language, a source test is generally MUCH larger
than a generating set. Maximal projected *generator* rank gives
injectivity ONLY on the selected generators, not on the function-closed
test or its common separator.

This file proves the exact maximal/drop dichotomy and combines
a collision of projected generators with the already verified strict
ORIGINAL-2019 partial-function small-image transfer. Thus such
collisions are handled by the preceding generator-rank induction,
without imposing the false fixed-root relative completion on every
closed n-vertex test.

This is the correct guard for the published picture-index induction;
it is not a proof of the still-open maximal mixed hard-root case.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {U V VB : Type v}
variable [DecidableEq V]

/-- Maximal projected generator rank forces injectivity of the
projection on the CHOSEN generating set G, not on the possibly much
larger closed hull generated by G. -/
theorem maximal_projected_generator_rank_injective
    (G : Finset U) (p : U → V) (n : ℕ)
    (hCard : G.card ≤ n)
    (hImage : (G.image p).card = n) :
    G.card = n ∧
      ∀ x ∈ G, ∀ y ∈ G, p x = p y → x = y := by
  classical
  have hLe : (G.image p).card ≤ G.card := Finset.card_image_le
  have hEq : G.card = n := by omega
  exact ⟨hEq, Finset.card_image_iff.mp (hImage.trans hEq.symm)⟩

/-- If two DISTINCT generators share a projected part, their
projected generating set has strictly fewer than n members.
Consequently the maximal-generator case excludes collisions
among the selected generators, but cannot exclude collisions
created later by functions. -/
theorem projected_generator_collision_rank_drop
    (G : Finset U) (p : U → V) (n : ℕ)
    (hCard : G.card ≤ n)
    (x y : U) (hx : x ∈ G) (hy : y ∈ G)
    (hxy : x ≠ y) (hproj : p x = p y) :
    (G.image p).card < n := by
  classical
  have hNotEq : (G.image p).card ≠ G.card := by
    intro hEq
    have hInj : ∀ a ∈ G, ∀ b ∈ G, p a = p b → a = b :=
      Finset.card_image_iff.mp hEq
    exact hxy (hInj x hx y hy hproj)
  have hLe : (G.image p).card ≤ G.card := Finset.card_image_le
  omega

/-- The FUNCTIONAL version of the first published two-case step.

For a genuinely function-closed source C generated by G with at
most n generators, a collision of two projected generators makes
the projected generator rank smaller than n. The verified EHN
projection-to-closed-hull theorem then pulls back the predecessor
rank-(n-1) strict original-partial B-tree witness.

No rooted mixed attachment, weak-test enlargement, arbitrary
function-graph completion or total-fibre global map is used. -/
theorem HasOriginalPartialTreeCompletion.of_EHN_generator_collision
    {Base : Structure L VB} {C : Structure L U}
    {D : Structure L V} {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (G : Finset U) (hGen : C.GeneratedBy (↑G : Set U))
    (n : ℕ) (hCard : G.card ≤ n)
    (x y : U) (hx : x ∈ G) (hy : y ∈ G)
    (hxy : x ≠ y) (hproj : p x = p y)
    (hPrev : LocallyGeneratedOriginalPartialTreeCompletable
      Base D (n - 1)) :
    HasOriginalPartialTreeCompletion Base C := by
  have hDrop : (G.image p).card < n :=
    projected_generator_collision_rank_drop G p n hCard
      x y hx hy hxy hproj
  exact HasOriginalPartialTreeCompletion.of_EHN_generator_image_drop
    hp G hGen n hDrop hPrev

end StructuralRamsey.Structure
