import PartiteConstruction.Functional.EHNIrreducibleRootOriginalPartialCompletion
import PartiteConstruction.Functional.FibreExactness

/-!
# Track D: actual active-function generated native separators

The hard strict functional Appendix A one-copy attachment has a
function-closed common separator with a genuine original-2019 EHN
projection into the selected A. A common root generated by two
or more vertices need NOT be reducible: if one real function
tuple is defined and its inputs generate the entire root, the
whole closed root is irreducible, regardless of its number of
generators or cardinality.

This file gives a directly testable ACTIVE-GENERATED criterion
for the ACTUAL closedTestPullback separator. Its EHN projection
is then a full embedding into A, providing the canonical root
map into Base. Under the TRUE predecessor generator-rank bounds
on each entire closed pullback side, both absolute strict
original-partial Base-tree completions synchronize RELATIVELY
over that same canonical full Base root.

The side generator bounds are explicit; neither genuine mixedness
nor a maximal generator image alone supplies them. The theorem
does not construct those bounds or claim the entire Hales--Jewett
line-history maximal-mixed-root schema.

No weak tested set is replaced by its generated hull; the input
hull is the ALREADY CLOSED actual common separator in the
stated sufficient criterion. All operations remain genuinely
set-valued, with original-2019 source-defined partial semantics.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U : Type v}

/-- A FULL structure generated by the inputs of ONE actually
DEFINED function application is irreducible, even when this
generating tuple has two or more distinct entries.

This is a finite/infinitary statement independent of vertex count.
The already verified generated-input-hull lemma proves
irreducibility of that closed hull; since the inputs generate
all of A, full inclusion of the hull is surjective, so
irreducibility transfers to A. -/
theorem irreducible_of_generated_by_defined_function
    (A : Structure L U)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → U)
    (hGen : A.GeneratedBy (Set.range xs))
    {y : U} (hy : y ∈ A.func Func xs) :
    A.Irreducible := by
  classical
  let H : Set U := A.functionClosure (Set.range xs)
  let hH : A.IsClosed H := A.functionClosure_isClosed (Set.range xs)
  let Hull := A.induce H hH
  have hIrr : Hull.Irreducible :=
    functionClosure_inputs_irreducible_of_value A Func xs hy
  let inc : Embedding Hull A := inclusion A H hH
  have hSurj : Function.Surjective inc := by
    intro z
    have hz : z ∈ H := by
      change z ∈ A.functionClosure (Set.range xs)
      rw [hGen]
      exact Set.mem_univ z
    exact ⟨⟨z, hz⟩, rfl⟩
  exact Irreducible.of_surjective_homomorphism
    (A := Hull) (B := A) hIrr inc.isHomomorphism hSurj


/-- A noninjective ORIGINAL-2019/EHN part projection cannot
coexist with a common root generated by the inputs of an
ACTUALLY DEFINED function operation.

This rules out applying the active-generated/irreducible
root completion shortcut when distinct historical Hales--Jewett
root vertices share a canonical selected A label. It is only
a source irreducibility/injectivity gate, not a negative
claim about general strict target-tree existence. -/
theorem IsEHNHomomorphismEmbedding.no_active_generation_of_noninjective
    {D : Structure L U}
    {W : Type v} {C : Structure L W}
    {p : W → U}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (hNotInj : ¬ Function.Injective p)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → W)
    {y : W} (hy : y ∈ C.func Func xs) :
    ¬ C.GeneratedBy (Set.range xs) := by
  intro hGen
  have hIrr : C.Irreducible :=
    irreducible_of_generated_by_defined_function C Func xs hGen hy
  obtain ⟨e, he⟩ :=
    hp.2 C hIrr (Embedding.id C)
  have hInj : Function.Injective p := by
    intro x z hxz
    apply e.injective
    calc
      e x = p x := he x
      _ = p z := hxz
      _ = e z := (he z).symm
  exact hNotInj hInj

end StructuralRamsey.Structure


namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {P U V W VB : Type v}

/-- In the ACTUAL native one-copy full-functional EHN
attachment, the common separator is automatically a FULL
selected-A root if it is generated by the inputs of a
genuinely DEFINED common-root function tuple.

Both closed pullback sides receive strict ORIGINAL-PARTIAL
relative Base-tree extensions over the SAME canonical map
`eAB ∘ WR.part ∘ pb.commonMap`.

No irreducibility of the entire old or core stages and no
global complete-fibre map are assumed. Side rank-n hypotheses
are explicit and must be proved separately in the actual
history-dependent maximal mixed case. -/
theorem native_closedTest_activeGeneratedRoot_compatibleRelative
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (Base : Structure L VB)
    (hBase : Base.Irreducible)
    (eAB : Structure.Embedding A Base)
    (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    (n : ℕ)
    (hCore : LocallyGeneratedOriginalPartialTreeCompletable
      Base Dsys.toStructure n)
    (hCopy : LocallyGeneratedOriginalPartialTreeCompletable
      Base B.toStructure n)
    (hLeftRank :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.left.GeneratedByAtMost n)
    (hRightRank :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.right.GeneratedByAtMost n)
    (hActive :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      ∃ (Func : L.FuncSymbol)
        (xs : Fin (L.funcArity Func) → pb.Common)
        (y : pb.Common),
        pb.common.GeneratedBy (Set.range xs) ∧
        y ∈ pb.common.func Func xs) :
    let pb := closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest
    ∃ (q : Structure.Embedding pb.common Base),
      (∀ x : pb.Common,
         q x = eAB ((B.weakRestrict Douter hB.1 A alpha).part
           (pb.commonMap x))) ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Base) Base pb.toLeft q ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Base) Base pb.toRight q := by
  classical
  let Supp := B.support alpha.toFunctionEmbedding
  let hSupp := B.weak_support_closed Douter hB.1 A alpha
  let pb := closedTestPullback B Supp hSupp Dsys f Test hTest
  let WR := B.weakRestrict Douter hB.1 A alpha
  obtain ⟨Func, xs, y, hGen, hy⟩ := hActive
  have hRoot : pb.common.Irreducible :=
    irreducible_of_generated_by_defined_function
      pb.common Func xs hGen hy
  have hRootEHN : pb.common.IsEHNHomomorphismEmbedding A
      (WR.part ∘ pb.commonMap) :=
    closedTestPullback_common_EHN
      B Douter hB A alpha Dsys f Test hTest
  obtain ⟨qA, hqA⟩ :=
    hRootEHN.2 pb.common hRoot
      (Structure.Embedding.id pb.common)
  let q : Structure.Embedding pb.common Base := eAB.comp qA
  have hCanonical :
      ∀ x : pb.Common, q x = eAB (WR.part (pb.commonMap x)) := by
    intro x
    exact congrArg eAB (hqA x)
  have hLeft : HasOriginalPartialTreeCompletion Base pb.left :=
    hCore.completion_of_embedding pb.left hLeftRank pb.leftMap
  have hRight : HasOriginalPartialTreeCompletion Base pb.right :=
    hCopy.completion_of_embedding pb.right hRightRank pb.rightMap
  have hRelL : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base pb.toLeft q :=
    HasOriginalPartialTreeExtensionCompletion.of_irreducible_root_absolute
      Base hBase hRoot pb.toLeft q hLeft
  have hRelR : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base pb.toRight q :=
    HasOriginalPartialTreeExtensionCompletion.of_irreducible_root_absolute
      Base hBase hRoot pb.toRight q hRight
  exact ⟨q, hCanonical, hRelL, hRelR⟩

end StructuralRamsey.FunctionalPartite.Attachment
