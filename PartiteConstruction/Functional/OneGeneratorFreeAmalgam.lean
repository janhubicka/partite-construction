import PartiteConstruction.Functional.ClosedGeneratorRank
import PartiteConstruction.Functional.FullFreeAmalgam

/-!
# The genuinely mixed closed attachment case starts at generator rank TWO

In the actual native functional EHN construction, every binary attachment
is a FULL free amalgam of two genuinely function-closed sides over a
function-closed root. A full structure generated by at most one vertex
cannot genuinely mix the two sides: its single generator lies in one side,
which is closed under all function outputs. The zero-generator case is
contained in BOTH sides because both side ranges are closed.

This fact does not require the control A to be irreducible, does not rely on
a special partite projection, and works even with nullary functions and
relations. It is an elementary, reusable structural lemma.

A corresponding statement for arbitrary n > 1 is false without further
compatibility hypotheses: generators in one side may produce common-root
outputs later used to generate vertices of the other side.
-/

namespace StructuralRamsey.Structure.IsFreeAmalgam

universe u v
variable {L : Language.{u}}
variable {H E F C : Type v}
variable {Root : Structure L H}
variable {Left : Structure L E} {Right : Structure L F}
variable {Whole : Structure L C}
variable {sL : Embedding Root Left} {sR : Embedding Root Right}
variable {iL : Embedding Left Whole} {iR : Embedding Right Whole}

/-- The FULL closure of an at-most-one-element generating set of a free
amalgam lies wholly on one side. The root need not be irreducible,
and the statement is valid for arbitrary function arities. -/
theorem one_generated_source_contained_in_side
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hGen : Whole.GeneratedByAtMost 1) :
    (∀ x : C, ∃ a : E, x = iL a) ∨
    (∀ x : C, ∃ b : F, x = iR b) := by
  classical
  obtain ⟨G, hGCard, hGGen⟩ := hGen
  have localize {SideCarrier : Type v}
      {Side : Structure L SideCarrier}
      (iSide : Embedding Side Whole)
      (hSeed : (↑G : Set C) ⊆ Set.range iSide) :
      ∀ x : C, ∃ y : SideCarrier, x = iSide y := by
    intro x
    have hx : x ∈ Whole.functionClosure (↑G : Set C) := by
      rw [hGGen]
      exact Set.mem_univ x
    obtain ⟨y, hy⟩ :=
      hx (Set.range iSide) iSide.range_isClosed hSeed
    exact ⟨y, hy.symm⟩
  by_cases hEmpty : G = ∅
  · left
    apply localize iL
    intro x hx
    simp [hEmpty] at hx
  · have hOne : G.card = 1 := by
      have hPos : 0 < G.card :=
        Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hEmpty)
      omega
    obtain ⟨g, hg⟩ := Finset.card_eq_one.mp hOne
    rw [hg] at hGGen
    rcases hfree.covers g with ⟨a,ha⟩ | ⟨b,hb⟩
    · left
      apply localize iL
      intro x hx
      have hxg : x = g := by simpa [hg] using hx
      exact ⟨a, ha.symm.trans hxg.symm⟩
    · right
      apply localize iR
      intro x hx
      have hxg : x = g := by simpa [hg] using hx
      exact ⟨b, hb.symm.trans hxg.symm⟩

/-- In particular, the n = 1 genuinely mixed branch of ANY native
functional free attachment is vacuous. A closed test with at most one
generator can be completed entirely in a constituent core or old copy.

No strong-root compatibility or tree-gluing hypothesis is required at
this first generator rank. -/
theorem one_generated_no_mixed
    (hfree : IsFreeAmalgam sL sR iL iR)
    (hGen : Whole.GeneratedByAtMost 1) :
    ¬ ((¬ ∀ x : C, ∃ a : E, x = iL a) ∧
       (¬ ∀ x : C, ∃ b : F, x = iR b)) := by
  intro hMixed
  rcases hfree.one_generated_source_contained_in_side hGen with hL | hR
  · exact hMixed.1 hL
  · exact hMixed.2 hR

end StructuralRamsey.Structure.IsFreeAmalgam
