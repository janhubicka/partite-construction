import PartiteConstruction.Functional.OneGeneratedRootRelativeCompletion
import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy

/-!
# Track D: canonical full A-charts on single-generated closed roots

A hard Hales--Jewett mixed separator can have DISTINCT vertices
with the SAME canonical A-label, so the entire EHN root projection
cannot be a full embedding into one A-copy. The positive
irreducible-collar route cannot address that case globally.

Nevertheless every one-vertex function-generated FULL closed hull
inside the separator is irreducible (even with infinitely many
function values). The EHN condition makes the map on each such
hull a FULL embedding into A. These local charts cover EVERY
actual root vertex, agree on their TRUE vertex overlaps, and
have no internal label collision.

This is a verified-candidate local-label atlas, NOT a complete
global root embedding: disjoint source hulls can have overlapping
A-images. Gluing them naively inside one Base copy would create
false identifications ('wrong hits'). A strict relative target
tree compatible with the ordered HJ history is still open.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- Literal FULL functional closure of one named root vertex. -/
noncomputable def singletonFunctionHull
    (C : Structure L U) (x : U) : Set U :=
  C.functionClosure (↑({x} : Finset U) : Set U)

theorem singletonFunctionHull_closed
    (C : Structure L U) (x : U) :
    C.IsClosed (singletonFunctionHull C x) :=
  C.functionClosure_isClosed (↑({x} : Finset U) : Set U)

theorem singletonFunctionHull_contains
    (C : Structure L U) (x : U) :
    x ∈ singletonFunctionHull C x := by
  classical
  exact C.subset_functionClosure
    (↑({x} : Finset U) : Set U) (by simp)

/-- The FULL induced one-vertex hull is generated by at most one
vertex regardless of the number of closure outputs. -/
theorem singletonFunctionHull_generatedByAtMostOne
    (C : Structure L U) (x : U) :
    (C.induce (singletonFunctionHull C x)
      (singletonFunctionHull_closed C x)).GeneratedByAtMost 1 := by
  classical
  have h :=
    C.functionClosure_finset_generatedByAtMost ({x} : Finset U)
  simpa only [singletonFunctionHull, Finset.card_singleton] using h

/-- Irreducibility of the entire one-vertex FULL induced hull. -/
theorem singletonFunctionHull_irreducible
    (C : Structure L U) (x : U) :
    (C.induce (singletonFunctionHull C x)
      (singletonFunctionHull_closed C x)).Irreducible :=
  irreducible_of_one_generated _
    (singletonFunctionHull_generatedByAtMostOne C x)

/-- Every vertex of a genuine EHN source belongs to one
function-closed irreducible hull which maps by a FULL
embedding to the functional control, with EXACT original
EHN vertex labels. -/
theorem IsEHNHomomorphismEmbedding.singleton_full_chart
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x : U) :
    ∃ e : Embedding
      (C.induce (singletonFunctionHull C x)
        (singletonFunctionHull_closed C x)) D,
      ∀ z : singletonFunctionHull C x, e z = p z.1 := by
  let H : Set U := singletonFunctionHull C x
  let hH : C.IsClosed H := singletonFunctionHull_closed C x
  let Small := C.induce H hH
  have hIrr : Small.Irreducible :=
    singletonFunctionHull_irreducible C x
  let inc : Embedding Small C := inclusion C H hH
  obtain ⟨e, he⟩ := hp.2 Small hIrr inc
  exact ⟨e, fun z => he z⟩

/-- Canonical EHN labels cannot collide WITHIN one FULL
one-generated hull. This remains true even when the
entire separator projection is noninjective. -/
theorem IsEHNHomomorphismEmbedding.singleton_hull_labels_injective
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x : U) :
    Function.Injective
      (fun z : singletonFunctionHull C x => p z.1) := by
  obtain ⟨e, he⟩ := hp.singleton_full_chart x
  intro z w hzw
  apply e.injective
  calc
    e z = p z.1 := he z
    _ = p w.1 := hzw
    _ = e w := (he w).symm

/-- Two local FULL charts provided by one EHN projection
automatically AGREE ON THE ACTUAL SOURCE OVERLAP, even
if their full A-images have extra intersections unrelated
to a source overlap.

The latter false extra hits remain the obstacle to
naively combining these local charts into one target
full embedding or strict B-tree history witness. -/
theorem IsEHNHomomorphismEmbedding.singleton_charts_agree
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x y : U) :
    ∃ (ex : Embedding
      (C.induce (singletonFunctionHull C x)
        (singletonFunctionHull_closed C x)) D)
      (ey : Embedding
      (C.induce (singletonFunctionHull C y)
        (singletonFunctionHull_closed C y)) D),
      ∀ (z : U)
        (hx : z ∈ singletonFunctionHull C x)
        (hy : z ∈ singletonFunctionHull C y),
        ex ⟨z, hx⟩ = ey ⟨z, hy⟩ := by
  obtain ⟨ex, hx⟩ := hp.singleton_full_chart x
  obtain ⟨ey, hy⟩ := hp.singleton_full_chart y
  refine ⟨ex, ey, ?_⟩
  intro z hzX hzY
  calc
    ex ⟨z, hzX⟩ = p z := hx ⟨z, hzX⟩
    _ = ey ⟨z, hzY⟩ := (hy ⟨z, hzY⟩).symm

/-- An exact GLUING GATE for canonical FULL root embeddings.

An EHN map C → D is a FULL structure embedding on that SAME vertex
map precisely when it is injective, reflects every relation tuple,
and reflects function-domain nonemptiness on EVERY input tuple.

Forward relations and exact images of nonempty SOURCE fibres
are already guaranteed by the genuine EHN axioms, so no
extra total-fibre premise is smuggled into this statement.

For a reducible Hales--Jewett root, local one-generated full charts
give NONE of the three global conditions by themselves:
- distinct local charts can have extra equal image vertices;
- cross-chart target relation tuples can be new;
- source-undefined cross-chart tuples can be target-defined.

This characterizes when one GLOBAL full root collar exists, but
does NOT assert that the historical root satisfies the conditions
or that the weaker original-partial relative B-tree construction
requires a full root embedding. -/
theorem IsEHNHomomorphismEmbedding.fullEmbedding_iff_inj_reflect_rel_domain
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p) :
    (∃ e : Embedding C D, ∀ x : U, e x = p x) ↔
      Function.Injective p ∧
      (∀ R xs, D.rel R (p ∘ xs) → C.rel R xs) ∧
      (∀ Func (xs : Fin (L.funcArity Func) → U),
        (D.func Func (p ∘ xs)).Nonempty →
          (C.func Func xs).Nonempty) := by
  constructor
  · rintro ⟨e, he⟩
    refine ⟨?_, ?_, ?_⟩
    · intro x y hxy
      apply e.injective
      calc
        e x = p x := he x
        _ = p y := hxy
        _ = e y := (he y).symm
    · intro R xs hD
      have hargs : e.toFun ∘ xs = p ∘ xs := by
        funext i
        exact he (xs i)
      exact (e.map_rel_iff R xs).mp (hargs ▸ hD)
    · intro Func xs hT
      have hargs : e.toFun ∘ xs = p ∘ xs := by
        funext i
        exact he (xs i)
      have hT' : (D.func Func (e.toFun ∘ xs)).Nonempty := by
        rw [hargs]
        exact hT
      obtain ⟨y, hy⟩ := hT'
      have himg : y ∈ imageSet e.toFun (C.func Func xs) := by
        rw [e.map_func Func xs]
        exact hy
      obtain ⟨z, hz, _⟩ := himg
      exact ⟨z, hz⟩
  · rintro ⟨hInjective, hRelReflect, hDomReflect⟩
    have hFull : C.IsHomomorphism D p :=
      hp.isHomomorphism_of_domainReflection hDomReflect
    let e : Embedding C D := {
      toFun := p
      injective := hInjective
      map_rel_iff := by
        intro R xs
        exact ⟨hRelReflect R xs, hFull.1 R xs⟩
      map_func := hFull.2
    }
    exact ⟨e, fun _ => rfl⟩


end StructuralRamsey.Structure


namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure
universe u v
variable {L : Language.{u}}
variable {P U V W : Type v}

/-- ACTUAL native closed Hales--Jewett attachment common separator:
for every literal root vertex x, its generated FULL function hull
has one exact canonical FULL chart into the selected A. The chart
is the restriction of the original partial EHN projection, not
a new freely chosen label.

This does NOT assert the whole root maps injectively into A; distinct
one-generated charts may have extra hits in A, which a history-respecting
strict target construction must still resolve. -/
theorem closedTestPullback_common_singleton_full_chart
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    (x :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.Common) :
    let pb := closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest
    let q : pb.Common → U :=
      (B.weakRestrict Douter hB.1 A alpha).part ∘ pb.commonMap
    ∃ e : Structure.Embedding
      (pb.common.induce (singletonFunctionHull pb.common x)
        (singletonFunctionHull_closed pb.common x)) A,
      ∀ z : singletonFunctionHull pb.common x, e z = q z.1 := by
  let Supp := B.support alpha.toFunctionEmbedding
  let hSupp := B.weak_support_closed Douter hB.1 A alpha
  let pb := closedTestPullback B Supp hSupp Dsys f Test hTest
  let WR := B.weakRestrict Douter hB.1 A alpha
  have hRoot : pb.common.IsEHNHomomorphismEmbedding A
      (WR.part ∘ pb.commonMap) :=
    closedTestPullback_common_EHN
      B Douter hB A alpha Dsys f Test hTest
  exact hRoot.singleton_full_chart x

end StructuralRamsey.FunctionalPartite.Attachment
