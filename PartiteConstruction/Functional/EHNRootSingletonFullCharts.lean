import PartiteConstruction.Functional.OneGeneratedRootRelativeCompletion
import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy

/-!
# Track D: canonical full A-charts on single-generated closed roots

A hard Hales--Jewett mixed separator can have DISTINCT vertices
with the SAME canonical A-label, so the entire EHN root projection
cannot be a full embedding into one A-copy. The positive
irreducible-collar route cannot address that case globally.

Nevertheless every one-vertex function-generated FULL closed hull
inside the separator is irreducible (even with infinitely many
function values). The EHN condition makes the map on each such
hull a FULL embedding into A. These local charts cover EVERY
actual root vertex, agree on their TRUE vertex overlaps, and
have no internal label collision.

This is a verified-candidate local-label atlas, NOT a complete
global root embedding: disjoint source hulls can have overlapping
A-images. Gluing them naively inside one Base copy would create
false identifications ('wrong hits'). A strict relative target
tree compatible with the ordered HJ history is still open.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- Literal FULL functional closure of one named root vertex. -/
noncomputable def singletonFunctionHull
    (C : Structure L U) (x : U) : Set U :=
  C.functionClosure (↑({x} : Finset U) : Set U)

theorem singletonFunctionHull_closed
    (C : Structure L U) (x : U) :
    C.IsClosed (singletonFunctionHull C x) :=
  C.functionClosure_isClosed (↑({x} : Finset U) : Set U)

theorem singletonFunctionHull_contains
    (C : Structure L U) (x : U) :
    x ∈ singletonFunctionHull C x := by
  classical
  exact C.subset_functionClosure
    (↑({x} : Finset U) : Set U) (by simp)

/-- The FULL induced one-vertex hull is generated by at most one
vertex regardless of the number of closure outputs. -/
theorem singletonFunctionHull_generatedByAtMostOne
    (C : Structure L U) (x : U) :
    (C.induce (singletonFunctionHull C x)
      (singletonFunctionHull_closed C x)).GeneratedByAtMost 1 := by
  classical
  have h :=
    C.functionClosure_finset_generatedByAtMost ({x} : Finset U)
  simpa only [singletonFunctionHull, Finset.card_singleton] using h

/-- Irreducibility of the entire one-vertex FULL induced hull. -/
theorem singletonFunctionHull_irreducible
    (C : Structure L U) (x : U) :
    (C.induce (singletonFunctionHull C x)
      (singletonFunctionHull_closed C x)).Irreducible :=
  irreducible_of_one_generated _
    (singletonFunctionHull_generatedByAtMostOne C x)

/-- Every vertex of a genuine EHN source belongs to one
function-closed irreducible hull which maps by a FULL
embedding to the functional control, with EXACT original
EHN vertex labels. -/
theorem IsEHNHomomorphismEmbedding.singleton_full_chart
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x : U) :
    ∃ e : Embedding
      (C.induce (singletonFunctionHull C x)
        (singletonFunctionHull_closed C x)) D,
      ∀ z : singletonFunctionHull C x, e z = p z.1 := by
  let H : Set U := singletonFunctionHull C x
  let hH : C.IsClosed H := singletonFunctionHull_closed C x
  let Small := C.induce H hH
  have hIrr : Small.Irreducible :=
    singletonFunctionHull_irreducible C x
  let inc : Embedding Small C := inclusion C H hH
  obtain ⟨e, he⟩ := hp.2 Small hIrr inc
  exact ⟨e, fun z => he z⟩

/-- Canonical EHN labels cannot collide WITHIN one FULL
one-generated hull. This remains true even when the
entire separator projection is noninjective. -/
theorem IsEHNHomomorphismEmbedding.singleton_hull_labels_injective
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x : U) :
    Function.Injective
      (fun z : singletonFunctionHull C x => p z.1) := by
  obtain ⟨e, he⟩ := hp.singleton_full_chart x
  intro z w hzw
  apply e.injective
  calc
    e z = p z.1 := he z
    _ = p w.1 := hzw
    _ = e w := (he w).symm

/-- Two local FULL charts provided by one EHN projection
automatically AGREE ON THE ACTUAL SOURCE OVERLAP, even
if their full A-images have extra intersections unrelated
to a source overlap.

The latter false extra hits remain the obstacle to
naively combining these local charts into one target
full embedding or strict B-tree history witness. -/
theorem IsEHNHomomorphismEmbedding.singleton_charts_agree
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x y : U) :
    ∃ (ex : Embedding
      (C.induce (singletonFunctionHull C x)
        (singletonFunctionHull_closed C x)) D)
      (ey : Embedding
      (C.induce (singletonFunctionHull C y)
        (singletonFunctionHull_closed C y)) D),
      ∀ (z : U)
        (hx : z ∈ singletonFunctionHull C x)
        (hy : z ∈ singletonFunctionHull C y),
        ex ⟨z, hx⟩ = ey ⟨z, hy⟩ := by
  obtain ⟨ex, hx⟩ := hp.singleton_full_chart x
  obtain ⟨ey, hy⟩ := hp.singleton_full_chart y
  refine ⟨ex, ey, ?_⟩
  intro z hzX hzY
  calc
    ex ⟨z, hzX⟩ = p z := hx ⟨z, hzX⟩
    _ = ey ⟨z, hzY⟩ := (hy ⟨z, hzY⟩).symm

end StructuralRamsey.Structure
