import PartiteConstruction.Functional.HistoryZero
import PartiteConstruction.Functional.OriginalPartialSemantics

/-!
# The rank-zero base of strict original-partial functional sparsening

If all function symbols have positive arity, a genuinely closed finite
test generated by zero vertices is empty.  To complete this test into
one genuine B-copy, use an embedding of B into the current full Ramsey
control D: even nullary RELATIONS are then preserved without inventing
a new target structure.

This is the original-2019 partial-function local-tree convention;
the resulting map happens to be a FULL embedding, because its source
is empty. No U-closure relational replay is used.

When D -> (B)^A_r and the colour set is nonempty, the required B ↪ D
follows directly from the Ramsey arrow, exactly as in the published
initial pass.  This lemma is the rank-zero starting point for the
generator-rank strengthening of the native iterated construction.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {V VB U : Type v}

/-- A closed test of rank zero embeds in an actual B-copy of the
ambient control D, provided B itself embeds in D. The extra embedding
hypothesis handles any nullary relation symbols correctly. -/
theorem closed_rank_zero_originalPartial_completion
    (Base : Structure L VB) (D : Structure L V)
    (hPos : L.PositiveFuncArity)
    (eBD : Embedding Base D)
    (H : Set V) (hH : D.IsClosed H)
    (hGen : (D.induce H hH).GeneratedByAtMost 0) :
    HasOriginalPartialTreeCompletion Base (D.induce H hH) := by
  classical
  let Small := D.induce H hH
  letI : IsEmpty H := GeneratedByAtMost.isEmpty_of_zero hPos hGen
  let inc : Embedding Small D := inclusion D H hH
  have hRange : ∀ x : H, ∃ b : VB, inc x = eBD b := by
    intro x
    exact isEmptyElim x
  let eSmall : Embedding Small Base :=
    inc.factorThroughClosedRange eBD hRange
  have hTree : TreeAmalgam Base VB Base :=
    TreeAmalgam.copy (Embedding.id Base) (fun b => ⟨b,rfl⟩)
  exact ⟨VB, Base, hTree, eSmall,
    eSmall.isEHNHomomorphismEmbedding.toOriginalPartial⟩

/-- The rank-zero strict completion is available in EVERY Ramsey
witness D for the arrow D -> (B)^A_r. The proof of this arrow
produces the B-placement needed for nullary symbols, without any
assumption that the empty test maps to B by an arbitrary map. -/
theorem closed_rank_zero_originalPartial_completion_of_arrow
    (A : Structure L U) (Base : Structure L VB)
    (D : Structure L V) (hPos : L.PositiveFuncArity)
    (κ : Type*) [Nonempty κ]
    (hArrow : Arrow A Base D κ)
    (H : Set V) (hH : D.IsClosed H)
    (hGen : (D.induce H hH).GeneratedByAtMost 0) :
    HasOriginalPartialTreeCompletion Base (D.induce H hH) := by
  classical
  obtain ⟨eBD, _⟩ := hArrow (fun _ =>
    Classical.choice (inferInstance : Nonempty κ))
  exact closed_rank_zero_originalPartial_completion Base D
    hPos eBD H hH hGen

end StructuralRamsey.Structure
