import PartiteConstruction.Functional.EHNActiveInputHullCollisionExclusion
import PartiteConstruction.Functional.EHNCollidingClosedRootDecomposition

/-!
# Track D: three source-side defects of a non-full EHN projection

A genuine EHN map is full on every irreducible source test.  Its full
embedding obstruction on the WHOLE source has exactly three possible
forms: vertex collisions, surplus positive target relations, or
target-defined/source-undefined function inputs.

The existing source-defined fibre exactness rules out any fourth,
independent loss-of-output defect.  This file gives the missing
relation-input analogue of the established function-domain hull
decomposition, then packages actual source-side proper FULL free
decompositions for every defect (with a finite source for collision).

In particular these are not certificates of compatible relative
strict B-tree TARGET extensions: the root's original-partial map
may legitimately identify vertices, and the source decompositions
need not be compatible with ordered Hales--Jewett attachment history.
The numbered manuscript is untouched.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- If a positive target relation occurs on the image of an actual
source tuple but the relation is absent from the source, the FULL
function-closed hull generated by THAT original tuple has a genuine
proper full-function free decomposition.

This is the exact relation counterpart of
`inputHull_reducible_of_domainFailure`; in particular no weak
substructure is enlarged or silently substituted for the source. -/
theorem IsEHNHomomorphismEmbedding.relationInputHull_reducible_of_reflectionFailure
    {C : Structure L U} {D : Structure L V} {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (R : L.RelSymbol) (xs : Fin (L.relArity R) → U)
    (hTarget : D.rel R (p ∘ xs))
    (hSource : ¬ C.rel R xs) :
    Nonempty (ProperFreeDecomposition
      (C.induce (C.functionClosure (Set.range xs))
        (C.functionClosure_isClosed (Set.range xs)))) := by
  classical
  let Hset := C.functionClosure (Set.range xs)
  have hHclosed : C.IsClosed Hset :=
    C.functionClosure_isClosed (Set.range xs)
  let H : Structure L Hset := C.induce Hset hHclosed
  by_contra hnone
  have hHirr : H.Irreducible := by
    rw [irreducible_iff_noProperFreeDecomposition]
    exact hnone
  let inc : Embedding H C := inclusion C Hset hHclosed
  obtain ⟨g, hg⟩ := hp.2 H hHirr inc
  let q : Fin (L.relArity R) → Hset :=
    fun i => ⟨xs i,
      C.subset_functionClosure (Set.range xs) ⟨i, rfl⟩⟩
  have hgargs : g ∘ q = p ∘ xs := by
    funext i
    exact hg (q i)
  have hTarget' : D.rel R (g ∘ q) := by
    rw [hgargs]
    exact hTarget
  have hSmallRel : H.rel R q :=
    (g.map_rel_iff R q).mp hTarget'
  apply hSource
  change C.rel R (Subtype.val ∘ q) at hSmallRel
  have hqx : Subtype.val ∘ q = xs := by
    funext i
    rfl
  rw [hqx] at hSmallRel
  exact hSmallRel

/-- Exhaustive trichotomy for failure of a FULL embedding on the SAME
underlying map as an EHN projection.  It uses the verified exact iff
criterion, not an assumption that the canonical EHN map is injective.

The last branch is a SOURCE-UNDEFINED input with a nonempty TARGET
fibre, not an extra value on an already source-defined input. -/
theorem IsEHNHomomorphismEmbedding.nonFull_exactThreeDefects
    {C : Structure L U} {D : Structure L V} {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (hNoFull : ¬ ∃ e : Embedding C D, ∀ x : U, e x = p x) :
    (∃ x y : U, x ≠ y ∧ p x = p y) ∨
    (∃ (R : L.RelSymbol) (xs : Fin (L.relArity R) → U),
      D.rel R (p ∘ xs) ∧ ¬ C.rel R xs) ∨
    (∃ (F : L.FuncSymbol) (xs : Fin (L.funcArity F) → U),
      (D.func F (p ∘ xs)).Nonempty ∧
        ¬ (C.func F xs).Nonempty) := by
  classical
  by_contra hNoDefect
  have hInj : Function.Injective p := by
    intro x y hEq
    by_contra hDistinct
    exact hNoDefect (Or.inl ⟨x, y, hDistinct, hEq⟩)
  have hRel : ∀ R xs, D.rel R (p ∘ xs) → C.rel R xs := by
    intro R xs hTarget
    by_contra hSource
    exact hNoDefect (Or.inr (Or.inl ⟨R, xs, hTarget, hSource⟩))
  have hDomain :
      ∀ F (xs : Fin (L.funcArity F) → U),
        (D.func F (p ∘ xs)).Nonempty →
          (C.func F xs).Nonempty := by
    intro F xs hTarget
    by_contra hSource
    exact hNoDefect (Or.inr (Or.inr ⟨F, xs, hTarget, hSource⟩))
  exact hNoFull
    (hp.fullEmbedding_iff_inj_reflect_rel_domain.mpr
      ⟨hInj, hRel, hDomain⟩)

/-- Every failure of a global FULL EHN embedding on a finite source
has an actual native source-side proper free-decomposition witness:
either the WHOLE source in the collision case, or the input-generated
full hull of a genuine missing relation / undefined function tuple.

The decomposition does NOT imply compatible relative B-tree extensions
for the two outer sides of the mixed HJ attachment. -/
theorem IsEHNHomomorphismEmbedding.nonFull_sourceDecompositionTrichotomy
    {C : Structure L U} {D : Structure L V} [Finite U]
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (hNoFull : ¬ ∃ e : Embedding C D, ∀ x : U, e x = p x) :
    (∃ x y : U, x ≠ y ∧ p x = p y ∧
        Nonempty (ProperFreeDecomposition C)) ∨
    (∃ (R : L.RelSymbol) (xs : Fin (L.relArity R) → U),
      D.rel R (p ∘ xs) ∧ ¬ C.rel R xs ∧
      Nonempty (ProperFreeDecomposition
        (C.induce (C.functionClosure (Set.range xs))
          (C.functionClosure_isClosed (Set.range xs))))) ∨
    (∃ (F : L.FuncSymbol) (xs : Fin (L.funcArity F) → U),
      (D.func F (p ∘ xs)).Nonempty ∧
      ¬ (C.func F xs).Nonempty ∧
      Nonempty (ProperFreeDecomposition
        (C.induce (C.functionClosure (Set.range xs))
          (C.functionClosure_isClosed (Set.range xs))))) := by
  rcases hp.nonFull_exactThreeDefects hNoFull with
      ⟨x, y, hDistinct, hEq⟩ |
      ⟨R, xs, hTarget, hSource⟩ |
      ⟨F, xs, hTarget, hSource⟩
  · exact Or.inl ⟨x, y, hDistinct, hEq,
      hp.proper_decomposition_of_collision x y hDistinct hEq⟩
  · exact Or.inr (Or.inl ⟨R, xs, hTarget, hSource,
      hp.relationInputHull_reducible_of_reflectionFailure
        R xs hTarget hSource⟩)
  · exact Or.inr (Or.inr ⟨F, xs, hTarget, hSource,
      hp.inputHull_reducible_of_domainFailure
        F xs hTarget hSource⟩)

end StructuralRamsey.Structure
