import PartiteConstruction.Functional.ClosedGeneratorRank
import PartiteConstruction.Functional.OccupiedAlphaControlExposure

/-!
# Track D: actual generator rank of an exposed function input hull

The maximal mixed native exact-weak-test obstruction exposes one
actual control function tuple all of whose SOURCE inputs are
TESTED vertices lying in the same full attachment side.

Although closing this tuple may add arbitrarily many FUNCTION
OUTPUT VERTICES, its closed input hull is generated by the
literal set of distinct tuple inputs. In a genuinely mixed
test S of size <=m+1, the side omits at least one tested vertex,
so the input set is a PROPER subset of S and has <=m members.

Consequently the full FUNCTION-CLOSED hull of the exposed
tuple inputs has generator rank <=m, with NO assumption that
the hull itself has <=m vertices. This is the correct
generator-rank resource available to the existing original-2019
closed generated-test machinery, not a justification for
replacing the weak S by its closure or changing its vertex bound.

This works for arbitrary set-valued function arities, including
nullary operations and repeated inputs, and does not use EHN
domain reflection. No compatible TARGET B-tree root extension
is asserted. The source-side exterior witness is essential.
-/

namespace StructuralRamsey.FunctionalPartite

open Structure

universe u v
variable {L : Language.{u}}
variable {P C E : Type v}

/-- The literal tuple-input set inside a mixed source side is a
proper subset of S, and therefore has at most m vertices.

No projection injectivity or function closure is used here.
This is a purely exact finite-source cardinal argument. -/
theorem System.mixedSide_functionInput_card_le
    (B : System L P C)
    (S : Finset C) (m : ℕ)
    (hS : S.card ≤ m + 1)
    {Left : Structure L E}
    (iL : Structure.Embedding Left B.toStructure)
    (hMixed : ∃ z : C, z ∈ S ∧ ∀ e : E, z ≠ iL e)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) →
      ↥((↑S : Set C) ∩ Set.range iL)) :
    ((Finset.univ : Finset (Fin (L.funcArity Func))).image
      (fun i => (xs i).1)).card ≤ m := by
  classical
  let G : Finset C :=
    (Finset.univ : Finset (Fin (L.funcArity Func))).image
      (fun i => (xs i).1)
  have hSub : G ⊆ S := by
    intro w hw
    obtain ⟨i, _hi, hEq⟩ := Finset.mem_image.mp hw
    rw [← hEq]
    exact (xs i).2.1
  obtain ⟨z, hzS, hzNotLeft⟩ := hMixed
  have hzNotG : z ∉ G := by
    intro hzG
    obtain ⟨i, _hi, hEq⟩ := Finset.mem_image.mp hzG
    obtain ⟨e, he⟩ := (xs i).2.2
    apply hzNotLeft e
    calc
      z = (xs i).1 := hEq.symm
      _ = iL e := he.symm
  have hProper : G ⊂ S := by
    apply Finset.ssubset_iff.mpr
    refine ⟨z, hzNotG, ?_⟩
    intro w hw
    rcases Finset.mem_insert.mp hw with rfl | hw
    · exact hzS
    · exact hSub hw
  have hSmall : G.card < S.card :=
    Finset.card_lt_card hProper
  change G.card ≤ m
  omega

/-- The full FUNCTION-CLOSED hull generated by the source inputs
of an exposed operation has generator rank at most m whenever
that input tuple lies in a source side missing a tested vertex.

The source exact weak test S is unchanged and may be NONCLOSED;
the input hull is a separate full induced Structure used ONLY
as a potential generated-rank predecessor diagnostic. -/
theorem System.mixedSide_functionInputHull_generatedByAtMost
    (B : System L P C)
    (S : Finset C) (m : ℕ)
    (hS : S.card ≤ m + 1)
    {Left : Structure L E}
    (iL : Structure.Embedding Left B.toStructure)
    (hMixed : ∃ z : C, z ∈ S ∧ ∀ e : E, z ≠ iL e)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) →
      ↥((↑S : Set C) ∩ Set.range iL)) :
    (B.toStructure.induce
      (B.toStructure.functionClosure (Set.range (Subtype.val ∘ xs)))
      (B.toStructure.functionClosure_isClosed
        (Set.range (Subtype.val ∘ xs)))).GeneratedByAtMost m := by
  classical
  let G : Finset C :=
    (Finset.univ : Finset (Fin (L.funcArity Func))).image
      (fun i => (xs i).1)
  have hCard : G.card ≤ m :=
    B.mixedSide_functionInput_card_le S m hS iL hMixed Func xs
  have hSet : (↑G : Set C) =
      Set.range (Subtype.val ∘ xs) := by
    ext y
    simp [G, Set.mem_range, Function.comp_apply]
  have hGenerated :=
    B.toStructure.functionClosure_finset_generatedByAtMost G
  have hBound :
      (B.toStructure.induce
        (B.toStructure.functionClosure (↑G : Set C))
        (B.toStructure.functionClosure_isClosed
          (↑G : Set C))).GeneratedByAtMost m :=
    hGenerated.mono hCard
  simpa only [hSet] using hBound

end StructuralRamsey.FunctionalPartite


namespace StructuralRamsey.FunctionalPartite

open Structure

universe u v
variable {L : Language.{u}}
variable {P C E UA : Type v}

/-- A concrete exposed control output tuple, as given by the
sharp native mixed-rank frontier, necessarily has an EXACT
predecessor-rank full input hull whenever the associated side
is genuinely mixed.

This retains the very SAME function symbol F, input tuple xs
and escaping output part q, and never replaces the weak S by a
larger test of its function closure. No EHN or stage local-tree
witness is required to establish the generator budget. -/
theorem System.exposedControlOutput_inputHull_rank_le_m
    (B : System L P C) (D : Structure L P)
    {A : Structure L UA}
    (alpha : Structure.Embedding A D)
    (S : Finset C) (m : ℕ) (hS : S.card ≤ m + 1)
    {Left : Structure L E}
    (iL : Structure.Embedding Left B.toStructure)
    (hMixed : ∃ z : C, z ∈ S ∧ ∀ e : E, z ≠ iL e)
    (hExposed : B.ExposedControlOutputAtAlpha D alpha
      ((↑S : Set C) ∩ Set.range iL)) :
    ∃ (Func : L.FuncSymbol)
      (xs : Fin (L.funcArity Func) →
        ↥((↑S : Set C) ∩ Set.range iL)) (q : P),
      (∀ i, B.part (xs i).1 ∈ Set.range alpha) ∧
      q ∈ D.func Func (B.part ∘ (Subtype.val ∘ xs)) ∧
      q ∉ B.part '' ((↑S : Set C) ∩ Set.range iL) ∧
      (B.toStructure.induce
        (B.toStructure.functionClosure (Set.range (Subtype.val ∘ xs)))
        (B.toStructure.functionClosure_isClosed
          (Set.range (Subtype.val ∘ xs)))).GeneratedByAtMost m := by
  obtain ⟨Func, xs, q, hInputs, hControl, hOutside⟩ := hExposed
  exact ⟨Func, xs, q, hInputs, hControl, hOutside,
    B.mixedSide_functionInputHull_generatedByAtMost
      S m hS iL hMixed Func xs⟩

end StructuralRamsey.FunctionalPartite
