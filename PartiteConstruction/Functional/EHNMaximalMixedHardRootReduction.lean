import PartiteConstruction.Functional.EHNNativeOriginalPartialOneGeneratedRoot
import PartiteConstruction.Functional.EHNNativeOriginalPartialMaximalMixedReduction

/-!
# The precise remaining maximal mixed-root obligation

The original 2019 strict functional Appendix A has now been verified
for genuine mixed tests whose actual full functional common separator
is generated by at most ONE element, irrespective of the number of
function-generated vertices in that separator.

The original maximal-mixed relative-extension schema is therefore
reducible to its restriction to genuinely mixed closed tests whose
common separator cannot be generated by one element. This is a precise
scope reduction, not a proof of that remaining hard-root schema.

All full Ramsey canonicalization, preceding generator-rank reduction,
and final B-coverage are reused from their already audited Lean modules.
-/

namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {P U V W VB : Type v}
variable [DecidableEq P]

/-- Request compatible relative strict B-tree completions ONLY when
the exact common full-functional closed separator needs at least TWO
generators, and the test meets the maximal projected generator case. -/
def NativeMaximalMixedHardRootRelativeExtension
    (B : System L P V) (S : Set V)
    (hS : B.toStructure.IsClosed S)
    (D : System L P W)
    (f : FunctionalPartite.Embedding (B.induce S hS) D)
    (Base : Structure L VB) (n : ℕ) : Prop :=
  ∀ (Test : Set (Structure.Attachment.Vertex S
      (W := W) (I := PUnit.{v+1})))
    (hTest : (UnitAttachD B S hS D f).toStructure.IsClosed Test)
    (G : Finset Test)
    (hGen : ((UnitAttachD B S hS D f).toStructure.induce
      Test hTest).GeneratedBy (↑G : Set Test))
    (hCard : G.card ≤ n)
    (hImage : (G.image
      (fun x : Test => (UnitAttachD B S hS D f).part x.1)).card = n)
    (hOutsideCore : ¬ ∀ x : Test, ∃ w : W,
      x.1 = unitCoreEmbedding B S hS D f w)
    (hOutsideCopy : ¬ ∀ x : Test, ∃ v : V,
      x.1 = unitCopyEmbedding B S hS D f v)
    (hHardRoot :
      ¬ ((closedTestPullback B S hS D f Test hTest).common.GeneratedByAtMost 1)),
    let pb := closedTestPullback B S hS D f Test hTest
    ∃ (G₀ : Type v) (Start : Structure L G₀) (q : pb.Common → G₀),
      TreeAmalgam Base G₀ Start ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Start) Base pb.toLeft q ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Start) Base pb.toRight q


/-- Assuming the hard-root request, the already verified one-generated
native separator theorem constructs both required relative extensions
in every other maximal mixed case. Hence the original complete local
mixed-root request follows with no additional Ramsey proof. -/
theorem NativeMaximalMixedOriginalPartialRelativeExtension.of_hardRoot
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (Base : Structure L VB)
    [Finite V] [Finite W]
    (hBase : Base.Irreducible)
    (eAB : Structure.Embedding A Base)
    (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (n : ℕ)
    (hCore : LocallyGeneratedOriginalPartialTreeCompletable
      Base Dsys.toStructure n)
    (hCopy : LocallyGeneratedOriginalPartialTreeCompletable
      Base B.toStructure n)
    (hHard : NativeMaximalMixedHardRootRelativeExtension
      B (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Base n) :
    NativeMaximalMixedOriginalPartialRelativeExtension
      B (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Base n := by
  classical
  intro Test hTest G hGen hCard hImage hNotCore hNotCopy
  let Supp := B.support alpha.toFunctionEmbedding
  let hSupp := B.weak_support_closed Douter hB.1 A alpha
  let pb := closedTestPullback B Supp hSupp Dsys f Test hTest
  by_cases hRootGen : pb.common.GeneratedByAtMost 1
  · have hWhole : ((UnitAttachD B Supp hSupp Dsys f).toStructure.induce
        Test hTest).GeneratedByAtMost n :=
      ⟨G, hCard, hGen⟩
    exact native_closedTest_oneGeneratedRoot_compatibleRelativeCompletions
      B Douter hB A Base hBase eAB alpha Dsys f
      Test hTest n hWhole hCore hCopy hNotCore hNotCopy hRootGen
  · exact hHard Test hTest G hGen hCard hImage
      hNotCore hNotCopy hRootGen

end StructuralRamsey.FunctionalPartite.Attachment
