import PartiteConstruction.Functional.EHNRootSingletonFullCharts
import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy

/-!
# Track D: source EHN label collisions cannot occur within an active input hull

The verified one-generated A atlas of a functional EHN source allows
extra hits between distinct source charts. But each genuinely defined
operation connects ALL its argument vertices inside ONE irreducible
full function-closed input hull, irrespective of the arity, number
of output vertices, or repeated arguments.

Consequently no two distinct source vertices in that very same
active input hull can have identical canonical EHN labels. This is
stronger than the existing no-global-active-generation condition:
the entire common separator need NOT be generated by one operation.
The collision can only occur across distinct active input hulls.

The theorem is instantiated on the ACTUAL closedTestPullback common
separator of a native binary EHN attachment, with its checked canonical
weak-restriction A part projection. This is a precise source-side
history obstruction, NOT a target strict B-tree relative completion.
No closure of the literal weak test, extra generator charges, or
domain-reflection of undefined operations are introduced.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- The original EHN labels are INJECTIVE on the FULL
function-closed hull of the inputs of ANY genuinely defined
operation. No one-generated or finite-carrier hypothesis is
needed: the actual function incidence itself connects all
inputs into a single irreducible full substructure. -/
theorem IsEHNHomomorphismEmbedding.defined_input_hull_labels_injective
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → U)
    {out : U} (hValue : out ∈ C.func Func xs) :
    Function.Injective
      (fun z : C.functionClosure (Set.range xs) => p z.1) := by
  let H : Set U := C.functionClosure (Set.range xs)
  let hH : C.IsClosed H :=
    C.functionClosure_isClosed (Set.range xs)
  let Small := C.induce H hH
  have hIrr : Small.Irreducible :=
    functionClosure_inputs_irreducible_of_value C Func xs hValue
  let inc : Embedding Small C := inclusion C H hH
  obtain ⟨e, he⟩ := hp.2 Small hIrr inc
  intro x y hxy
  apply e.injective
  calc
    e x = p x.1 := he x
    _ = p y.1 := hxy
    _ = e y := (he y).symm

/-- Two distinct EHN-colliding source vertices can NEVER BOTH
belong to the full input hull of one defined operation. This
holds even when the whole source structure is reducible and has
many different active connected pieces. -/
theorem IsEHNHomomorphismEmbedding.collision_separates_active_input_hulls
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x y : U) (hDistinct : x ≠ y) (hCollision : p x = p y)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → U)
    (hDefined : (C.func Func xs).Nonempty) :
    ¬ (x ∈ C.functionClosure (Set.range xs) ∧
       y ∈ C.functionClosure (Set.range xs)) := by
  rintro ⟨hx, hy⟩
  obtain ⟨out, hout⟩ := hDefined
  have hInj :=
    hp.defined_input_hull_labels_injective Func xs hout
  apply hDistinct
  have hh : (⟨x, hx⟩ :
      C.functionClosure (Set.range xs)) =
      (⟨y, hy⟩ :
      C.functionClosure (Set.range xs)) :=
    hInj hCollision
  exact congrArg Subtype.val hh

/-- The image of a source-active input hull in a selected control
has NO extra vertex collisions internally. Any wrong hits of a
global canonical A atlas must therefore relate vertices outside
one another's common genuinely active input hull. -/
theorem IsEHNHomomorphismEmbedding.colliding_second_outside_active_hull
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x y : U) (hDistinct : x ≠ y) (hCollision : p x = p y)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) → U)
    (hDefined : (C.func Func xs).Nonempty)
    (hx : x ∈ C.functionClosure (Set.range xs)) :
    y ∉ C.functionClosure (Set.range xs) := by
  intro hy
  exact hp.collision_separates_active_input_hulls
    x y hDistinct hCollision Func xs hDefined ⟨hx, hy⟩


/-- A relation tuple connects all its argument vertices in the
strong FULL functional free-amalgamation sense: if they GENERATE
the whole structure, then every full embedding of that structure
into a free amalgam is wholly on one side.

The proof uses the genuine source relation tuple and closure of
a FULL side embedding. It works for any relation arity, including
nullary relations, and all set-valued function arities. -/
theorem irreducible_of_generated_by_relation_tuple
    (A : Structure L U)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → U)
    (hRel : A.rel R xs)
    (hGen : A.Generates xs) :
    A.Irreducible := by
  intro H E F C Dsrc Esrc Fsrc Csrc sE sF iE iF hFree e
  have hTarget : Csrc.rel R (e.toFun ∘ xs) :=
    (e.map_rel_iff R xs).mpr hRel
  rcases (hFree.rel_iff R (e.toFun ∘ xs)).mp hTarget with
    ⟨a, _ha, ha⟩ | ⟨b, _hb, hb⟩
  · left
    have hClosed : A.IsClosed
        {z : U | e z ∈ Set.range iE} :=
      e.preimage_isClosed (Set.range iE) iE.range_isClosed
    have hInputs : ∀ i : Fin (L.relArity R),
        e (xs i) ∈ Set.range iE := by
      intro i
      exact ⟨a i, (congrFun ha i).symm⟩
    intro z
    exact hGen _ hClosed hInputs z
  · right
    have hClosed : A.IsClosed
        {z : U | e z ∈ Set.range iF} :=
      e.preimage_isClosed (Set.range iF) iF.range_isClosed
    have hInputs : ∀ i : Fin (L.relArity R),
        e (xs i) ∈ Set.range iF := by
      intro i
      exact ⟨b i, (congrFun hb i).symm⟩
    intro z
    exact hGen _ hClosed hInputs z

/-- The FULL function-closed hull of the inputs of a genuine
relation tuple is irreducible. The hull can be much larger than
the tuple because it retains every original set-valued function
output. This is the relation counterpart of the checked theorem
for DEFINED function applications. -/
theorem functionClosure_relation_inputs_irreducible
    (A : Structure L U)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → U)
    (hRel : A.rel R xs) :
    let H := A.functionClosure (Set.range xs)
    (A.induce H (A.functionClosure_isClosed (Set.range xs))).Irreducible := by
  let H : Set U := A.functionClosure (Set.range xs)
  let hH : A.IsClosed H := A.functionClosure_isClosed (Set.range xs)
  let Small := A.induce H hH
  let q : Fin (L.relArity R) → H := closureLift A xs
  have hSmallRel : Small.rel R q := by
    change A.rel R (Subtype.val ∘ q)
    simpa [q, closureLift, Function.comp_apply] using hRel
  have hSmallGen : Small.Generates q :=
    closureLift_generates A xs
  exact irreducible_of_generated_by_relation_tuple
    Small R q hSmallRel hSmallGen

/-- EHN canonical labels are FULL and injective on each
function-closed hull generated by an actual RELATION tuple,
just as they are on the hull of one defined function tuple.
Any label collisions have to cross these active source atoms. -/
theorem IsEHNHomomorphismEmbedding.relation_input_hull_labels_injective
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → U)
    (hRel : C.rel R xs) :
    Function.Injective
      (fun z : C.functionClosure (Set.range xs) => p z.1) := by
  let H : Set U := C.functionClosure (Set.range xs)
  let hH : C.IsClosed H := C.functionClosure_isClosed (Set.range xs)
  let Small := C.induce H hH
  have hIrr : Small.Irreducible :=
    functionClosure_relation_inputs_irreducible C R xs hRel
  let inc : Embedding Small C := inclusion C H hH
  obtain ⟨e, he⟩ := hp.2 Small hIrr inc
  intro x y hxy
  apply e.injective
  calc
    e x = p x.1 := he x
    _ = p y.1 := hxy
    _ = e y := (he y).symm

/-- A literal collision of EHN labels cannot be contained in
the SAME full function-closed hull of any actual relation tuple.
No choice of global root decomposition or target B-tree is made. -/
theorem IsEHNHomomorphismEmbedding.collision_separates_relation_hulls
    {C : Structure L U} {D : Structure L V}
    {p : U → V}
    (hp : C.IsEHNHomomorphismEmbedding D p)
    (x y : U) (hDistinct : x ≠ y) (hCollision : p x = p y)
    (R : L.RelSymbol)
    (xs : Fin (L.relArity R) → U)
    (hRel : C.rel R xs) :
    ¬ (x ∈ C.functionClosure (Set.range xs) ∧
       y ∈ C.functionClosure (Set.range xs)) := by
  rintro ⟨hx, hy⟩
  have hInj :=
    hp.relation_input_hull_labels_injective R xs hRel
  apply hDistinct
  have hh : (⟨x, hx⟩ :
      C.functionClosure (Set.range xs)) =
      (⟨y, hy⟩ :
      C.functionClosure (Set.range xs)) :=
    hInj hCollision
  exact congrArg Subtype.val hh

end StructuralRamsey.Structure


namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {P U V W : Type v}

/-- For the actual full-functional common separator of a native
closed EHN attachment, colliding selected A labels cannot both
lie inside ANY single genuinely defined common-root function
input hull. This uses the exact preexisting common separator,
not the closure of the original weak tested vertex set. -/
theorem closedTestPullback_common_collision_separates_defined_hull
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    (x y : (closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest).Common)
    (hDistinct : x ≠ y)
    (hCollision :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      let q : pb.Common → U :=
        (B.weakRestrict Douter hB.1 A alpha).part ∘ pb.commonMap
      q x = q y)
    (Func : L.FuncSymbol)
    (xs : Fin (L.funcArity Func) →
      (closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest).Common)
    (hDefined :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      (pb.common.func Func xs).Nonempty) :
    let pb := closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest
    ¬ (x ∈ pb.common.functionClosure (Set.range xs) ∧
       y ∈ pb.common.functionClosure (Set.range xs)) := by
  let pb := closedTestPullback B
    (B.support alpha.toFunctionEmbedding)
    (B.weak_support_closed Douter hB.1 A alpha)
    Dsys f Test hTest
  let q : pb.Common → U :=
    (B.weakRestrict Douter hB.1 A alpha).part ∘ pb.commonMap
  have hp : pb.common.IsEHNHomomorphismEmbedding A q :=
    closedTestPullback_common_EHN
      B Douter hB A alpha Dsys f Test hTest
  exact hp.collision_separates_active_input_hulls
    x y hDistinct hCollision Func xs hDefined

end StructuralRamsey.FunctionalPartite.Attachment
