import PartiteConstruction.Functional.EHNOriginalPartialHardRootSchema
import PartiteConstruction.Functional.EHNStrictIteratedNoACopy

/-!
# Sharpest checked conditional full-function strict sparsening statement

Combine two already verified independent scope reductions:

1. The native full-functional maximal-mixed-root relative completion
   request is automatic for a common separator generated by at most
   one vertex, regardless of how many closure vertices it contains.
   The remaining relative extension schema is restricted to genuine
   maximal tests of rank >=2 whose common root needs >=2 generators.

2. The n-pass original-2019 partial-function Ramsey and final B-copy
   theorem does not require an artificial embedding A ↪ B. If there
   is no A-copy in B, the Ramsey statement is vacuous and B itself
   is an appropriate strict one-copy B-tree witness.

This module combines the independently checked reductions, leaving
exactly the higher-rank, multi-generated-root side-extension problem
as an explicit CONDITIONAL hypothesis. No recursive/induced Ramsey
bookkeeping is duplicated and no total-fibre global homomorphism is
asserted. The schema is still unproved.
-/

namespace StructuralRamsey.FunctionalPartite.EHN.StrictRanked

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {U V P : Type v}

/-- Entire genuine functional n-pass original-2019 strict sparsening
with full Ramsey embeddings, original-partial composite projection,
strict full-functional closed vertex-n B-tree completions, and
genuine irreducible B-cover, assuming only compatible relative
completions at maximal mixed rank >=2 with common root requiring
at least TWO generators.

No artificial A ↪ B hypothesis is required: the conditional hard-root
schema is requested only if A actually embeds into B. This result is
NOT an unconditional proof of the multi-generated mixed-root lemma. -/
theorem sparsening_of_hard_root_schema_from_two_all
    (K : Structure.StructureClass (L := L))
    (hK : Structure.FreeAmalgamationClass K)
    (A : Structure L U) (Base : Structure L V) (D : Structure L P)
    [Finite U] [Finite V] [Finite P]
    (hKA : K A) (hKB : K Base)
    (hBIrr : Base.Irreducible) (hPos : L.PositiveFuncArity)
    (κ : Type*) [Fintype κ] [Nonempty κ]
    (hArrow : Structure.Arrow A Base D κ)
    (hHard : ∀ _eAB : Structure.Embedding A Base,
      MaximalMixedHardRootSchemaFromTwo K A Base)
    (n : ℕ) (hn : 0 < n) :
    ∃ (W : Type v) (_ : Finite W) (C : Structure L W),
      K C ∧
      Structure.Arrow A Base C κ ∧
      (∃ p : W → P, IsOriginalPartialHomomorphismEmbedding C D p) ∧
      LocallyClosedOriginalPartialTreeCompletable Base C n ∧
      IrreduciblesExtendTo Base C ∧
      LooseTreeAmalgam Base W C := by
  exact sparsening_of_maximal_mixed_schema_from_two_all
    K hK A Base D hKA hKB hBIrr hPos
    κ hArrow
    (fun eAB =>
      MaximalMixedSchemaFromTwo.of_hardRoot hBIrr eAB (hHard eAB))
    n hn

end StructuralRamsey.FunctionalPartite.EHN.StrictRanked
