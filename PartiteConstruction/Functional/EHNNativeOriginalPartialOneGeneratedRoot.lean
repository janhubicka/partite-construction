import PartiteConstruction.Functional.OneGeneratedRootRelativeCompletion
import PartiteConstruction.Functional.EHNClosedPullbackRootDichotomy

/-!
# Exact native EHN maximal mixed test with ONE-GENERATED separator

This is the genuine function-language closed-test pullback of a binary
native EHN attachment. The common root need not have at most one vertex:
it need only be generated by at most one vertex, perhaps yielding many
additional vertices under function closure.

Under the ACTUAL maximal-mixed side-exterior hypotheses and the
n-generator bound on the closed source test, both closed pullback
sides are still n-generated (the root costs one generator but at least
one exterior source generator is discarded on each side).

The canonical EHN map of the common root to the selected A then becomes
a FULL embedding because every one-generated full functional structure
is irreducible. After composing with A ↪ Base it is a prescribed full
root embedding into a single Base copy. The two side rank-n strict
local invariants provide ABSOLUTE B-tree completions, which are now
converted to compatible RELATIVE completions of the SAME root tree.

This discharges a nontrivial part of the uniform maximal mixed-root
schema. It is independent of the cardinality of the root, which may be
large, and does not assert the result for roots that require >=2
generators or the stronger survey total-fibre global projection.
-/

namespace StructuralRamsey.FunctionalPartite.Attachment

open StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {P U V W VB : Type v}

/-- A genuinely mixed exact native closed n-generated test whose full
functional common separator is ONE-GENERATED has BOTH compatible
strict original-partial B-tree relative side completions.

Only the original 2019 EHN partial-function map is used. No weak source
test is closed by adding vertices, and no bound on root cardinality is
required. -/
theorem native_closedTest_oneGeneratedRoot_compatibleRelativeCompletions
    (B : System L P V) (Douter : Structure L P)
    (hB : B.WeaklyPartiteOver Douter)
    (A : Structure L U) (Base : Structure L VB)
    [Finite V] [Finite W]
    (hBase : Base.Irreducible)
    (eAB : Structure.Embedding A Base)
    (alpha : Structure.Embedding A Douter)
    (Dsys : System L P W)
    (f : FunctionalPartite.Embedding
      (B.induce (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)) Dsys)
    (Test : Set
      (Structure.Attachment.Vertex
        (B.support alpha.toFunctionEmbedding)
        (W := W) (I := PUnit.{v+1})))
    (hTest :
      (UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.IsClosed Test)
    (n : ℕ)
    (hWholeGen :
      ((UnitAttachD B (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f).toStructure.induce Test hTest).GeneratedByAtMost n)
    (hCore : LocallyGeneratedOriginalPartialTreeCompletable
      Base Dsys.toStructure n)
    (hCopy : LocallyGeneratedOriginalPartialTreeCompletable
      Base B.toStructure n)
    (hNotCore :
      ¬ ∀ x : Test, ∃ w : W,
        x.1 = unitCoreEmbedding B
          (B.support alpha.toFunctionEmbedding)
          (B.weak_support_closed Douter hB.1 A alpha) Dsys f w)
    (hNotCopy :
      ¬ ∀ x : Test, ∃ v : V,
        x.1 = unitCopyEmbedding B
          (B.support alpha.toFunctionEmbedding)
          (B.weak_support_closed Douter hB.1 A alpha) Dsys f v)
    (hRootGen :
      let pb := closedTestPullback B
        (B.support alpha.toFunctionEmbedding)
        (B.weak_support_closed Douter hB.1 A alpha)
        Dsys f Test hTest
      pb.common.GeneratedByAtMost 1) :
    let pb := closedTestPullback B
      (B.support alpha.toFunctionEmbedding)
      (B.weak_support_closed Douter hB.1 A alpha)
      Dsys f Test hTest
    ∃ (G : Type v) (Start : Structure L G) (q : pb.Common → G),
      TreeAmalgam Base G Start ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Start) Base pb.toLeft q ∧
      HasOriginalPartialTreeExtensionCompletion
        (Start := Start) Base pb.toRight q := by
  classical
  let Supp := B.support alpha.toFunctionEmbedding
  let hSupp := B.weak_support_closed Douter hB.1 A alpha
  let pb := closedTestPullback B Supp hSupp Dsys f Test hTest
  letI : Finite (Structure.Attachment.Vertex Supp
      (W := W) (I := PUnit.{v+1})) := inferInstance
  letI : Finite Test :=
    Finite.of_injective Subtype.val Subtype.val_injective
  letI : Finite pb.Left :=
    Finite.of_injective pb.leftIn pb.leftIn.injective
  letI : Finite pb.Right :=
    Finite.of_injective pb.rightIn pb.rightIn.injective
  letI : Finite pb.Common :=
    Finite.of_injective pb.toLeft pb.toLeft.injective
  have hNotLeft : ¬ ∀ x : Test, ∃ a : pb.Left,
      x = pb.leftIn a := by
    intro h
    apply hNotCore
    intro x
    obtain ⟨a, ha⟩ := h x
    refine ⟨pb.leftMap a, ?_⟩
    calc
      x.1 = (pb.leftIn a).1 := congrArg Subtype.val ha
      _ = unitCoreEmbedding B Supp hSupp Dsys f (pb.leftMap a) :=
        pb.left_factor a
  have hNotRight : ¬ ∀ x : Test, ∃ a : pb.Right,
      x = pb.rightIn a := by
    intro h
    apply hNotCopy
    intro x
    obtain ⟨a, ha⟩ := h x
    refine ⟨pb.rightMap a, ?_⟩
    calc
      x.1 = (pb.rightIn a).1 := congrArg Subtype.val ha
      _ = unitCopyEmbedding B Supp hSupp Dsys f (pb.rightMap a) :=
        pb.right_factor a
  let WR := B.weakRestrict Douter hB.1 A alpha
  have hRoot : pb.common.Irreducible :=
    irreducible_of_one_generated pb.common hRootGen
  have hRootEHN : pb.common.IsEHNHomomorphismEmbedding A
      (WR.part ∘ pb.commonMap) :=
    closedTestPullback_common_EHN
      B Douter hB A alpha Dsys f Test hTest
  obtain ⟨qA, _hqA⟩ :=
    hRootEHN.2 pb.common hRoot (Structure.Embedding.id pb.common)
  let q : Structure.Embedding pb.common Base := eAB.comp qA
  have hCoreSmall : LocallyGeneratedOriginalPartialTreeCompletable
      Base pb.left n :=
    hCore.pullback_embedding pb.leftMap
  have hCopySmall : LocallyGeneratedOriginalPartialTreeCompletable
      Base pb.right n :=
    hCopy.pullback_embedding pb.rightMap
  obtain ⟨hLeft, hRight⟩ :=
    pb.free.compatibleOriginalPartialRelativeCompletions_one_generated_root
      hNotLeft hNotRight Base hBase q n hRootGen
      hWholeGen hCoreSmall hCopySmall
  have hTree : TreeAmalgam Base VB Base :=
    TreeAmalgam.copy (Structure.Embedding.id Base)
      (fun x => ⟨x, rfl⟩)
  exact ⟨VB, Base, q, hTree, hLeft, hRight⟩

end StructuralRamsey.FunctionalPartite.Attachment
