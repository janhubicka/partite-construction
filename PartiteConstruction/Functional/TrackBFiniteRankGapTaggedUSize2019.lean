import PartiteConstruction.Functional.TrackBFiniteRankGap2019
import PartiteConstruction.Functional.NativePartiteWeakUClosureRankDictionary
import PartiteConstruction.Functional.WholeMaskWholeWeakUSize2019
import PartiteConstruction.Functional.NativePartialClosure
import PartiteConstruction.Functional.LegacyWeakPartialCommutation2019

/-!
# Track B: direct OLD USize regression on the genuine finite weak cut

The previously compiled finite transversal example establishes a
clipped one-generator weak source and a whole-fibre weak source that
cannot be generated by one vertex. Apply the exact independently
verified SAME-S 2019 rank dictionaries, and the faithful native
Option(Set) generator equivalence, to obtain a direct inequality
in the two original canonical tagged USize presentations.

This is not a counterexample to the full closed-support USize
equivalence: the example's two-point cut is not function-closed.
-/

namespace StructuralRamsey.FunctionalPartite.TrackBFiniteRankGap

open StructuralRamsey
open StructuralRamsey.Structure
open StructuralRamsey.PartialSetStructure
open StructuralRamsey.RelStructure

private theorem positiveArity : lang.PositiveFuncArity := by
  intro F
  cases F
  decide

noncomputable instance : Fintype cut :=
  Fintype.ofFinite cut

/-- Original output-part-split/clipped ambient tagged 2019 USize of
the exact two-vertex test is ≤ 1, while its complete whole-mask/
whole-fibre ambient 2019 USize is NOT ≤ 1. Both source objects are
the actual faithful presentations of the SAME native transversal
partite structure, with no added vertices or ambient closure hull. -/
theorem tagged_USize_rank_gap :
    (USize (lang.outputPartIndexed (Fin 3)).patternClosureRules
      ((patternTagExpansion
        (system.splitOutputParts).toStructure.patternGraph).induce cut) ≤ 1) ∧
    ¬ (USize (lang.wholeMaskClosureRules (Fin 3))
      ((wholeMaskTagExpansion
        (system.toStructure.toNonemptyPartial.wholeMaskPatternGraph system.part)).induce cut) ≤ 1) := by
  constructor
  · have hPartial :
        ((system.toStructure.weakInduce cut).toNonemptyPartial).GeneratedByAtMost 1 := by
      rw [Structure.toNonemptyPartial_weakInduce_commute]
      exact clipped_generated_by_one
    have hNative :
        (system.toStructure.weakInduce cut).GeneratedByAtMost 1 :=
      ((system.toStructure.weakInduce cut).toNonemptyPartial_generatedByAtMost_iff 1).mp hPartial
    exact (system.weakGeneratedByAtMost_iff_outputTaggedUSize_le
      positiveArity cut 1).mp hNative
  · intro hU
    have hWhole :
        (wholeWeakInduce system.toStructure.toNonemptyPartial cut).GeneratedByAtMost 1 :=
      (system.toStructure.toNonemptyPartial.wholeWeakGeneratedByAtMost_iff_inducedAmbientUSize_le
        system.part positiveArity system.toNonemptyPartial_fibreTransversal cut 1).mpr hU
    exact whole_not_generated_by_one hWhole

end StructuralRamsey.FunctionalPartite.TrackBFiniteRankGap
