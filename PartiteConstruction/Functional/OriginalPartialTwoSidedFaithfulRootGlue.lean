import PartiteConstruction.Functional.EHNIrreducibleInputCoverRootReroot
import PartiteConstruction.Functional.OriginalPartialRootedTreeGlue

/-!
# Track D: two strict ORIGINAL-PARTIAL side trees glue over a faithful root

This is the target-side payoff of the checked one-sided rerooting lemmas.
A full functional free amalgam Root → Left, Right may have a REDUCIBLE,
multi-generated common source root. Suppose each side separately has an
absolute strict functional Base-tree target and an original-2019 PARTIAL
homomorphism-embedding into it, which need not be full or injective AWAY
FROM ROOT. If the root restriction of each chosen side map is a FULL
embedding into one target Base-constituent, both can be rerooted over
ANY prescribed full Root → Base map and glued by the verified relative
original-partial tree theorem. No independent side-root marks need agree.

A second theorem checks root fullness using the verified three-defect
criterion: injectivity on the real root, irreducible FULL source-test
coverage of all primitive relation and function input tuples, and root
image containment in a target Base constituent on each side.

CRITICAL LIMIT: a colliding canonical EHN root projection has no FULL
root embedding into Base on those labels. This route does not settle
the remaining history-compatible strict B-tree extension of actual
maximal-mixed Hales--Jewett separators. No exact weak test is enlarged.
Frozen survey Appendix A is untouched.
-/

namespace StructuralRamsey.Structure

universe u v
variable {L : Language.{u}}
variable {H E F Z VB YL YR : Type v}

/-- Two absolute ORIGINAL-PARTIAL functional B-tree side targets can be
synchronized over ONE prescribed full Root→Base embedding if only the
ROOT RESTRICTIONS of their side maps are full embeddings into
irreducible target constituents. Side maps need not themselves be full.
Root may be reducible and multi-generated. -/
theorem IsFreeAmalgam.originalPartialTreeCompletion_of_partialSides_faithfulRoot
    {Root : Structure L H}
    {Left : Structure L E} {Right : Structure L F}
    {Whole : Structure L Z}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hSrc : IsFreeAmalgam sL sR iL iR)
    (Base : Structure L VB)
    (hBase : Base.Irreducible)
    (q : Embedding Root Base)
    (TL : Structure L YL) (TR : Structure L YR)
    (hTL : TreeAmalgam Base YL TL)
    (hTR : TreeAmalgam Base YR TR)
    (pL : E → YL) (pR : F → YR)
    (hpL : Left.IsOriginalPartialHomomorphismEmbedding TL pL)
    (hpR : Right.IsOriginalPartialHomomorphismEmbedding TR pR)
    (rootL : Embedding Root TL)
    (rootR : Embedding Root TR)
    (hPieceL : rootL.ContainedInIrreducible)
    (hPieceR : rootR.ContainedInIrreducible)
    (hRootL : ∀ x : H, pL (sL x) = rootL x)
    (hRootR : ∀ x : H, pR (sR x) = rootR x) :
    HasOriginalPartialTreeCompletion Base Whole := by
  have hRelativeL : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base sL q :=
    HasOriginalPartialTreeExtensionCompletion.of_partial_side_full_root
      Base hBase sL q TL hTL pL hpL rootL hPieceL hRootL
  have hRelativeR : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base sR q :=
    HasOriginalPartialTreeExtensionCompletion.of_partial_side_full_root
      Base hBase sR q TR hTR pR hpR rootR hPieceR hRootR
  have hStart : TreeAmalgam Base VB Base :=
    TreeAmalgam.copy (Embedding.id Base) (fun x => ⟨x, rfl⟩)
  exact hSrc.originalPartialTreeCompletion_glue_relative
    Base hStart q hRelativeL hRelativeR

/-- Practical input-cover version of two-sided relative original-partial
functional gluing: each absolute side map need only be ROOT-INJECTIVE
and ROOT-FAITHFUL (old relation/function inputs are protected by
genuine full irreducible source tests). Its root image is required to
lie within one genuine Base-constituent of the chosen strict side
tree. The root itself need not be irreducible.

These hypotheses are NOT automatic for colliding HJ separators;
neither the exact old weak tested rank nor previous line histories
are generated by this statement. -/
theorem IsFreeAmalgam.originalPartialTreeCompletion_of_partialSides_inputCover
    {Root : Structure L H}
    {Left : Structure L E} {Right : Structure L F}
    {Whole : Structure L Z}
    {sL : Embedding Root Left} {sR : Embedding Root Right}
    {iL : Embedding Left Whole} {iR : Embedding Right Whole}
    (hSrc : IsFreeAmalgam sL sR iL iR)
    (Base : Structure L VB)
    (hBase : Base.Irreducible)
    (q : Embedding Root Base)
    (TL : Structure L YL) (TR : Structure L YR)
    (hTL : TreeAmalgam Base YL TL)
    (hTR : TreeAmalgam Base YR TR)
    (pL : E → YL) (pR : F → YR)
    (hpL : Left.IsOriginalPartialHomomorphismEmbedding TL pL)
    (hpR : Right.IsOriginalPartialHomomorphismEmbedding TR pR)
    (hInjectiveL : Function.Injective (pL ∘ sL))
    (hInjectiveR : Function.Injective (pR ∘ sR))
    (hRelCover : RelationInputsCoveredByIrreducibles Root)
    (hFuncCover : FunctionInputsCoveredByIrreducibles Root)
    (pieceL : Embedding Base TL)
    (pieceR : Embedding Base TR)
    (hPieceL : ∀ x : H, ∃ y : VB, pL (sL x) = pieceL y)
    (hPieceR : ∀ x : H, ∃ y : VB, pR (sR x) = pieceR y) :
    HasOriginalPartialTreeCompletion Base Whole := by
  have hRelativeL : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base sL q :=
    HasOriginalPartialTreeExtensionCompletion.of_partial_side_root_input_covers
      Base hBase sL q TL hTL pL hpL
      hInjectiveL hRelCover hFuncCover pieceL hPieceL
  have hRelativeR : HasOriginalPartialTreeExtensionCompletion
      (Start := Base) Base sR q :=
    HasOriginalPartialTreeExtensionCompletion.of_partial_side_root_input_covers
      Base hBase sR q TR hTR pR hpR
      hInjectiveR hRelCover hFuncCover pieceR hPieceR
  have hStart : TreeAmalgam Base VB Base :=
    TreeAmalgam.copy (Embedding.id Base) (fun x => ⟨x, rfl⟩)
  exact hSrc.originalPartialTreeCompletion_glue_relative
    Base hStart q hRelativeL hRelativeR

end StructuralRamsey.Structure
