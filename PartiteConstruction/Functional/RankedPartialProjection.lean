import PartiteConstruction.Functional.RankedTreeReduct
import PartiteConstruction.Functional.OriginalPartialSemantics
import PartiteConstruction.Functional.FibreExactness

/-!
# Ranked singleton fibres: the partial functional projection survives reduct

A naive argument that each nonempty ranked fibre is preserved is NOT
sufficient: the target might have extra outputs in a different rank.
However, once ANY ranked source fibre is nonempty on a tuple, the
function-closed hull generated by that input is irreducible. The EHN
projection embeds this whole hull, and therefore reflects ALL ranked
function fibres on that input, including empty ranked fibres.

Consequently the rank reduct preserves the complete original
set-valued fibre on every NONEMPTY source input. This gives the
correct 2019 partial homomorphism property for multivalued fibres.

This result does not yet prove that EHN's irreducible-embedding
qualification itself descends along rank reduct.
-/

namespace StructuralRamsey.Structure

open StructuralRamsey

universe u v
variable {L : Language.{u}} {U V : Type v}

/-- Positive weak homomorphisms commute with forgetting rank labels.
No nonempty-domain hypothesis is needed for this direction. -/
theorem IsWeakHomomorphism.rankReduct
    {n : ℕ}
    {A : Structure (L.rankFunctions n) U}
    {B : Structure (L.rankFunctions n) V}
    {p : U → V}
    (hp : A.IsWeakHomomorphism B p) :
    (Structure.rankReduct A).IsWeakHomomorphism
      (Structure.rankReduct B) p := by
  constructor
  · exact hp.1
  · intro F x y hy
    change ∃ i : Fin n, y ∈ A.func (F, i) x at hy
    obtain ⟨i, hi⟩ := hy
    exact ⟨i, hp.2 (F, i) x y hi⟩

/-- The **whole union of all ranks** maps onto the target union if at
least one source rank is defined. The proof uses the *same* irreducible
input hull for ALL ranks, not separate nonempty-fibre arguments.

This also handles repeated function arguments, because the hull is
generated by their set of vertices. -/
theorem IsEHNHomomorphismEmbedding.rankReduct_map_func_of_nonempty
    {n : ℕ}
    {A : Structure (L.rankFunctions n) U}
    {B : Structure (L.rankFunctions n) V}
    {p : U → V}
    (hp : A.IsEHNHomomorphismEmbedding B p)
    (F : L.FuncSymbol)
    (x : Fin (L.funcArity F) → U)
    (hSrc : ((Structure.rankReduct A).func F x).Nonempty) :
    imageSet p ((Structure.rankReduct A).func F x) =
      (Structure.rankReduct B).func F (p ∘ x) := by
  classical
  obtain ⟨a, ha⟩ := hSrc
  change ∃ i : Fin n, a ∈ A.func (F, i) x at ha
  obtain ⟨i₀, ha₀⟩ := ha
  let Hset := A.functionClosure (Set.range x)
  have hHClosed : A.IsClosed Hset :=
    A.functionClosure_isClosed (Set.range x)
  let H : Structure (L.rankFunctions n) Hset := A.induce Hset hHClosed
  have hHIrred : H.Irreducible := by
    change (A.induce Hset
      (A.functionClosure_isClosed (Set.range x))).Irreducible
    exact functionClosure_inputs_irreducible_of_value A (F, i₀) x ha₀
  let inc : Embedding H A := inclusion A Hset hHClosed
  obtain ⟨g, hg⟩ := hp.2 H hHIrred inc
  let q : Fin (L.funcArity F) → Hset :=
    fun i => ⟨x i, A.subset_functionClosure
      (Set.range x) ⟨i, rfl⟩⟩
  have hqA : Subtype.val ∘ q = x := rfl
  have hgArgs : g ∘ q = p ∘ x := by
    funext i
    exact hg (q i)
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ∃ j : Fin n, z ∈ A.func (F, j) x at hz
    obtain ⟨j, hj⟩ := hz
    exact ⟨j, hp.1.2 (F, j) x z hj⟩
  · intro hy
    change ∃ j : Fin n, y ∈ B.func (F, j) (p ∘ x) at hy
    obtain ⟨j, hj⟩ := hy
    have hj' : y ∈ B.func (F, j) (g ∘ q) := by
      exact hgArgs.symm ▸ hj
    have himage : y ∈ imageSet g (H.func (F, j) q) := by
      rw [g.map_func (F, j) q]
      exact hj'
    obtain ⟨z, hz, hzy⟩ := himage
    refine ⟨z.1, ?_, ?_⟩
    · change ∃ k : Fin n, z.1 ∈ A.func (F, k) x
      refine ⟨j, ?_⟩
      change z.1 ∈ A.func (F, j) (Subtype.val ∘ q) at hz
      exact hqA ▸ hz
    · calc
        p z.1 = g z := (hg z).symm
        _ = y := hzy

/-- The corrected 2019 partial-function preservation law descends
from an EHN weak projection in a singleton-ranked language to its
possibly multivalued rank reduct.  Crucially, it reflects no
UNDEFINED source fibre. -/
theorem IsEHNHomomorphismEmbedding.rankReduct_partialHomomorphism
    {n : ℕ}
    {A : Structure (L.rankFunctions n) U}
    {B : Structure (L.rankFunctions n) V}
    {p : U → V}
    (hp : A.IsEHNHomomorphismEmbedding B p) :
    IsOriginalPartialHomomorphism
      (Structure.rankReduct A) (Structure.rankReduct B) p := by
  constructor
  · exact (hp.1.rankReduct).1
  · intro F x hSrc
    exact hp.rankReduct_map_func_of_nonempty F x hSrc

end StructuralRamsey.Structure
