import AllThoseEPPA.MainTheorems
import AllThoseEPPA.TreeLikeIrreducibleExtensionLift

/-!
# EPPA statements in the Ramsey classification survey

This consumer module deliberately distinguishes the survey's definitions from
those in *All those EPPA classes*.

* A survey homomorphism preserves each set-valued function fibre by EQUALITY.
  The EPPA paper defines homomorphisms by INCLUSION. For unary functions the
  extra equality follows for a homomorphism-embedding: use the irreducible
  substructure generated by each input vertex. We prove that translation.
* The survey's local finiteness demands every irreducible substructure to be
  EXTENDIBLE TO A FULL A-COPY IN THE TEST STRUCTURE. The EPPA paper only asks
  that it embed into A. These are not definitionally equivalent. We give a
  separate local-completion interface and PROVE the survey-style EPPA transfer,
  rather than incorrectly invoking the paper-style local-finiteness theorem.
* The paper's forbidden-family theorem requires an AMBIENT EPPA extension.
  The unqualified forbidden-homomorphism claim printed in the survey cannot
  be deduced from it.
* All statements here are for relation symbols of positive arity, and for
  set-valued unary function symbols. The main survey additionally admits
  nullary relation symbols; those require an independent encoding.

The external library is pinned in lakefile.toml. This file is a proof module,
not a source of additional axioms.
-/

namespace SurveyEPPA
open AllThoseEPPA

universe u v w x

variable {L : Language.{u}} [L.HasUnaryFunctions]
variable {Γ : Type w} [Group Γ]

/-- The *survey*'s equality, rather than merely inclusion, for the function
fibres of a homomorphism. -/
def HasExactFunctionFibres
    {V : Type v} {W : Type x}
    (act : L.Action Γ)
    {A : Structure L V} {B : Structure L W}
    (f : Structure.Homomorphism act A B) : Prop :=
  ∀ {n : ℕ} (F : L.FuncSymbol n) (xs : Fin n → V),
    Structure.imageSet f.toFun (A.func F xs) =
      B.func (act.onFunc f.lang F) (f.toFun ∘ xs)

/-- The key definition bridge. Every unary input vertex generates an
irreducible, function-closed substructure, and an EPPA-paper
homomorphism-embedding is an exact embedding there. -/
theorem paperHomEmbedding_exactFunctionFibres
    {V : Type v} {W : Type x}
    (act : L.Action Γ) {A : Structure L V} {B : Structure L W}
    (f : Structure.Homomorphism act A B)
    (hf : Structure.Homomorphism.IsHomomorphismEmbedding act f) :
    HasExactFunctionFibres act f := by
  intro n F xs
  have hn : n = 1 := Language.HasUnaryFunctions.arity_eq_one F
  subst n
  let x : V := xs 0
  let S : Set V := A.closureAtSet x
  have hS : A.IsClosed S := A.isClosed_closureSet {x}
  have hIrr : (A.induce S hS).IsIrreducible := by
    change (A.closureAt x).IsIrreducible
    exact A.closureAt_isIrreducible x
  have hOn := hf S hS hIrr
  exact hOn.2.2 F xs (by
    intro i
    have hi : i = (0 : Fin 1) := Subsingleton.elim i 0
    subst i
    exact A.mem_closureAtSet x)

/-- Survey homomorphism-embedding, after supplying the map as a paper-style
homomorphism. There is no extra injectivity requirement globally. -/
def IsSurveyHomomorphismEmbedding
    {V : Type v} {W : Type x}
    (act : L.Action Γ) {A : Structure L V} {B : Structure L W}
    (f : Structure.Homomorphism act A B) : Prop :=
  Structure.Homomorphism.IsHomomorphismEmbedding act f ∧
    HasExactFunctionFibres act f

/-- For UNARY functions, the two homomorphism-embedding notions coincide,
even though the underlying notions of arbitrary homomorphism differ. -/
theorem paperHomEmbedding_iff_surveyHomEmbedding
    {V : Type v} {W : Type x}
    (act : L.Action Γ) {A : Structure L V} {B : Structure L W}
    (f : Structure.Homomorphism act A B) :
    Structure.Homomorphism.IsHomomorphismEmbedding act f ↔
      IsSurveyHomomorphismEmbedding act f := by
  constructor
  · intro hf
    exact ⟨hf, paperHomEmbedding_exactFunctionFibres act f hf⟩
  · exact And.left

/-- The survey's unrestricted EPPA theorem specialized to a finite group
acting trivially on symbols. In particular one may take the trivial group,
regardless of how many symbols the language contains. -/
theorem unrestrictedFaithfulCoherentEPPA_forTrivialFiniteAction
    {α : Type v} [Finite α]
    [Finite Γ]
    (A : Structure L α) :
    ∃ (β : Type (max u v)) (_ : Finite β)
      (B : Structure L β)
      (ι : Structure.Embedding (Language.Action.trivial L Γ) A B),
      Structure.IsCoherentEPPAWitness (Language.Action.trivial L Γ) ι ∧
      Structure.IsIrreducibleStructureFaithful (Language.Action.trivial L Γ) ι := by
  have hOrbit :
      A.HasFiniteRelabelOrbit (Language.Action.trivial L Γ) := by
    unfold Structure.HasFiniteRelabelOrbit
    exact Set.finite_range _
  exact MainTheorems.unrestrictedFaithfulCoherentEPPA
    (Language.Action.trivial L Γ) A hOrbit

/-- Survey restricted theorem: the library supplies actual full-A tree
amalgamations. The homomorphism-embedding clauses have the survey's exact
unary-fibre semantics by the equivalence proved above. -/
theorem restrictedEPPA_withSurveyFunctionSemantics
    {α β : Type (max u v)} [Finite α] [Finite β]
    (act : L.Action Γ)
    (A : Structure L α) (B₀ : Structure L β)
    (ψ : Structure.Embedding act A B₀)
    (hEPPA : Structure.IsEPPAWitness act ψ)
    (n : ℕ) :
    ∃ (δ : Type (max u v)) (_ : Finite δ)
      (B : Structure L δ) (ι : Structure.Embedding act A B),
      Structure.IsEPPAWitness act ι ∧
      Structure.IsIrreducibleStructureFaithful act ι ∧
      (∃ f : Structure.Homomorphism act B B₀,
        IsSurveyHomomorphismEmbedding act f) ∧
      (∀ (S : Set δ) (hS : B.IsClosed S),
        S.ncard ≤ n →
          ∃ (W : Type (max u v)) (H : Structure L W),
            TreeLike.TreeAmalgamation act A H ∧
            ∃ f : Structure.Homomorphism act (B.induce S hS) H,
              IsSurveyHomomorphismEmbedding act f) ∧
      (Structure.IsCoherentEPPAWitness act ψ →
        Structure.IsCoherentEPPAWitness act ι) := by
  obtain ⟨δ, hδ, B, ι, hEPPAnew, hFaith, hProjection,
      hSmallTrees, hCoh⟩ :=
    MainTheorems.restrictedLocallyTreeLikeEPPA
      act A B₀ ψ hEPPA n
  refine ⟨δ, hδ, B, ι, hEPPAnew, hFaith, ?_, ?_, hCoh⟩
  · obtain ⟨f, hf⟩ := hProjection
    exact ⟨f, (paperHomEmbedding_iff_surveyHomEmbedding act f).mp hf⟩
  · intro S hS hSize
    obtain ⟨W, H, hTree, f, hf⟩ := hSmallTrees S hS hSize
    exact ⟨W, H, hTree, f,
      (paperHomEmbedding_iff_surveyHomEmbedding act f).mp hf⟩

/-- Honest generalized Herwig-Lascar statement. Unlike the printed survey
version, this requires an ambient structure N extending all partial
automorphisms and forbids homomorphism-EMBEDDINGS. -/
theorem generalizedHerwigLascar_withAmbient
    {α : Type (max u v)} [Finite α]
    {M : Type x}
    (F : HerwigLascar.FiniteForbiddenFamily.{u,v,(max u v)} L)
    (act : L.Action Γ)
    (A : Structure L α)
    (hOrbit : A.HasFiniteRelabelOrbit act)
    (N : Structure L M)
    (a : Structure.Embedding act A N)
    (hExt : Structure.IsEPPAWitness act a)
    (hAvoid : F.Avoids act N) :
    ∃ (δ : Type (max u v)) (_ : Finite δ)
      (B : Structure L δ) (ι : Structure.Embedding act A B),
      Structure.IsCoherentEPPAWitness act ι ∧
      Structure.IsIrreducibleStructureFaithful act ι ∧
      F.Avoids act B := by
  exact MainTheorems.herwigLascar
    F act A hOrbit N a hExt hAvoid

/-- Turn a Γ-automorphism into its exact Γ-embedding. -/
private noncomputable def automorphismAsEmbedding
    {V : Type v} (act : L.Action Γ) {B : Structure L V}
    (g : Structure.Automorphism act B) :
    Structure.Embedding act B B where
  lang := g.lang
  toFun := g
  injective := g.toEquiv.injective
  map_rel_iff := by
    intro n R xs
    exact g.map_rel_iff R xs
  map_func := by
    intro n F xs
    exact g.map_func F xs

/-- Irreducible-structure faithfulness gives exactly the INSIDE-B extension
of irreducibles demanded by the survey, not merely embeddability into A. -/
theorem faithful_irreduciblesExtendInside
    {U : Type v} {V : Type x}
    (act : L.Action Γ)
    {A : Structure L U} {B : Structure L V}
    (ι : Structure.Embedding act A B)
    (hFaith : Structure.IsIrreducibleStructureFaithful act ι) :
    TreeLike.EveryIrreducibleExtendsToA act A B := by
  intro S hS hIrr
  obtain ⟨g, hg⟩ := hFaith S hS hIrr
  let j : Structure.Embedding act A B :=
    (automorphismAsEmbedding act g.symm).comp ι
  refine ⟨j, ?_⟩
  intro z hz
  obtain ⟨a, ha⟩ := hg z hz
  refine ⟨a, ?_⟩
  change g.symm (ι a) = z
  rw [← ha, Structure.Automorphism.symm_apply_apply]

/-- The survey's local-finiteness premise (the first condition is that
irreducibles extend to full A-copies INSIDE B).

Completion is still automorphism preserving and strong. Only ordinary
completions of small closed substructures are assumed.
For unary functions the HE conditions are equivalent by the lemma above. -/
def HasSurveyLocallyFiniteAutomorphismPreservingCompletion
    {α β : Type (max u v)} [Finite α] [Finite β]
    (act : L.Action Γ)
    (A : Structure L α) (B₀ : Structure L β)
    (K : TreeLike.FiniteAmalgamationClass act) : Prop :=
  ∃ n : ℕ,
    ∀ {δ : Type (max u v)} [Finite δ]
      (B : Structure L δ),
      TreeLike.EveryIrreducibleExtendsToA act A B →
      (∃ f : Structure.Homomorphism act B B₀,
        Structure.Homomorphism.IsHomomorphismEmbedding act f) →
      (∀ (S : Set δ) (hS : B.IsClosed S),
        S.ncard ≤ n → K.HasCompletion (B.induce S hS)) →
      ∃ (Z : Type (max u v)) (_ : Finite Z)
        (C : Structure L Z),
        K.mem C ∧
        Nonempty (Structure.AutomorphismPreservingStrongCompletion act B C)

/-- The survey-style local finiteness is sufficient for the key construction,
even though it is weaker than the paper's local-finiteness predicate. -/
theorem restrictedEPPA_inSurveyLocallyFiniteClass
    {α β : Type (max u v)} [Finite α] [Finite β]
    (act : L.Action Γ)
    (A : Structure L α) (hIrr : A.IsIrreducible)
    (K : TreeLike.FiniteAmalgamationClass act) (hKA : K.mem A)
    (B₀ : Structure L β)
    (ψ : Structure.Embedding act A B₀)
    (hEPPA : Structure.IsEPPAWitness act ψ)
    (hLocal : HasSurveyLocallyFiniteAutomorphismPreservingCompletion
      act A B₀ K) :
    ∃ (Z : Type (max u v)) (_ : Finite Z)
      (C : Structure L Z)
      (ι : Structure.Embedding act A C),
      K.mem C ∧
      Structure.IsEPPAWitness act ι ∧
      (Structure.IsCoherentEPPAWitness act ψ →
        Structure.IsCoherentEPPAWitness act ι) := by
  classical
  obtain ⟨n, hLocalN⟩ := hLocal
  obtain ⟨δ, hδ, B, ι, hEPPAnew, hFaith, hProjection,
      hSmallTrees, hCoherentTransfer⟩ :=
    MainTheorems.restrictedLocallyTreeLikeEPPA
      act A B₀ ψ hEPPA n
  letI : Finite δ := hδ
  have hEvery : TreeLike.EveryIrreducibleExtendsToA act A B :=
    faithful_irreduciblesExtendInside act ι hFaith
  have hSmallComplete :
      ∀ (S : Set δ) (hS : B.IsClosed S),
        S.ncard ≤ n → K.HasCompletion (B.induce S hS) :=
    TreeLike.smallClosedTrees_haveCompletions
      act A hIrr K hKA B n hSmallTrees
  obtain ⟨Z, hZ, C, hKC, ⟨c⟩⟩ :=
    hLocalN B hEvery hProjection hSmallComplete
  let ιC : Structure.Embedding act A C :=
    c.completedEmbedding ι hIrr
  refine ⟨Z, hZ, C, ιC, hKC, ?_, ?_⟩
  · exact c.preservesEPPA_of_irreducible ι hIrr hEPPAnew
  · intro hCoherent
    exact c.preservesCoherentEPPA_of_irreducible
      ι hIrr (hCoherentTransfer hCoherent)

/-- The *survey* version of the EPPA transfer (ordinary): the local
hypothesis is the in-test-structure extension condition, which is NOT
interchangeable with the paper's Definition 11.2. -/
theorem locallyFiniteEPPA_surveyCriterion
    (act : L.Action Γ)
    (K : TreeLike.HereditaryFiniteStrongAmalgamationClass act)
    (E : {V : Type (max u v)} → Structure L V → Prop)
    (hSub :
      ∀ {α : Type (max u v)} [Finite α]
        (A : Structure L α),
        K.toAmalgamationClass.mem A → E A)
    (hE : TreeLike.FiniteClassHasEPPA act E)
    (hIrr :
      ∀ {α : Type (max u v)} [Finite α]
        (A : Structure L α),
        K.toAmalgamationClass.mem A → A.IsIrreducible)
    (hLocal :
      ∀ {α β : Type (max u v)} [Finite α] [Finite β]
        (A : Structure L α) (B₀ : Structure L β),
        K.toAmalgamationClass.mem A → E B₀ →
        HasSurveyLocallyFiniteAutomorphismPreservingCompletion
          act A B₀ K.toAmalgamationClass) :
    K.toAmalgamationClass.HasEPPA := by
  intro α hα A hKA
  obtain ⟨β, hβ, B₀, ψ, hEB, hEPPA⟩ :=
    hE A (hSub A hKA)
  letI : Finite β := hβ
  obtain ⟨Z, hZ, C, ι, hKC, hEPPAnew, _⟩ :=
    restrictedEPPA_inSurveyLocallyFiniteClass
      act A (hIrr A hKA) K.toAmalgamationClass hKA
      B₀ ψ hEPPA (hLocal A B₀ hKA hEB)
  exact ⟨Z, hZ, C, ι, hKC, hEPPAnew⟩

/-- The coherent strengthening of the actual SURVEY local-finiteness
criterion. Its proof keeps the ordinary local completion condition. -/
theorem locallyFiniteCoherentEPPA_surveyCriterion
    (act : L.Action Γ)
    (K : TreeLike.HereditaryFiniteStrongAmalgamationClass act)
    (E : {V : Type (max u v)} → Structure L V → Prop)
    (hSub :
      ∀ {α : Type (max u v)} [Finite α]
        (A : Structure L α),
        K.toAmalgamationClass.mem A → E A)
    (hE : TreeLike.FiniteClassHasCoherentEPPA act E)
    (hIrr :
      ∀ {α : Type (max u v)} [Finite α]
        (A : Structure L α),
        K.toAmalgamationClass.mem A → A.IsIrreducible)
    (hLocal :
      ∀ {α β : Type (max u v)} [Finite α] [Finite β]
        (A : Structure L α) (B₀ : Structure L β),
        K.toAmalgamationClass.mem A → E B₀ →
        HasSurveyLocallyFiniteAutomorphismPreservingCompletion
          act A B₀ K.toAmalgamationClass) :
    K.toAmalgamationClass.HasCoherentEPPA := by
  intro α hα A hKA
  obtain ⟨β, hβ, B₀, ψ, hEB, ⟨c⟩⟩ :=
    hE A (hSub A hKA)
  letI : Finite β := hβ
  obtain ⟨Z, hZ, C, ι, hKC, _hEPPA, hCoherentTransfer⟩ :=
    restrictedEPPA_inSurveyLocallyFiniteClass
      act A (hIrr A hKA) K.toAmalgamationClass hKA
      B₀ ψ (c.isEPPAWitness act) (hLocal A B₀ hKA hEB)
  exact ⟨Z, hZ, C, ι, hKC, hCoherentTransfer ⟨c⟩⟩

end SurveyEPPA
